# Supabase Postgres (Settings › Database › Connection string › URI, "Transaction pooler" 6543 yerine "Session" 5432 önerilir)
DATABASE_URI=postgresql://postgres.xxxx:SIFRE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# 32+ karakter rastgele
PAYLOAD_SECRET=
# Panel adresi (ör. https://panel.updated.com.tr) ve site adresi
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001
WEB_URL=http://localhost:4321
# Stüdyo (Haber Masası) adresi: CORS ve içe aktarma
STUDIO_URL=https://studio.updated.com.tr
# Stüdyo'nun taslak gönderirken kullandığı anahtar (Supabase Secrets'a da aynı değer)
STUDIO_IMPORT_KEY=
# Supabase Storage S3 (Storage › Settings › S3 Connection)
S3_BUCKET=media
S3_REGION=eu-central-1
S3_ENDPOINT=https://xxxx.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Görsellerin herkese açık adresi (public bucket)
MEDIA_PUBLIC_URL=https://xxxx.supabase.co/storage/v1/object/public/media
# Site önbelleğini yenilemek için (Vercel ISR bypass token, web ile aynı)
ISR_BYPASS_TOKEN=
# IndexNow (Bing, Yandex) anahtarı; web/public/<anahtar>.txt ile aynı
INDEXNOW_KEY=

# Sitedeki taslak önizleme parolası (apps/web PREVIEW_SECRET ile aynı)
PREVIEW_SECRET=
