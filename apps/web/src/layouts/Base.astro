---
import '../styles/brand.css'
import '../styles/kunye.css'
import Header from '../components/Header.astro'
import BreakingStrip from '../components/BreakingStrip.astro'
import Footer from '../components/Footer.astro'
import { getBreaking, getSite } from '../lib/api'
import { SITE, siteLd, type Meta } from '../lib/seo'
import { ico } from '../lib/ui'
import { env } from '../lib/env'
interface Props { meta: Meta; breaking?: boolean; bodyClass?: string }
const { meta, breaking = true, bodyClass } = Astro.props
const staging = env('STAGING') === '1' // hazırlık sitesi arama motorlarına kapalı
const [site, hot] = await Promise.all([getSite(), breaking ? getBreaking() : Promise.resolve([])])
const url = SITE + (meta.path === '/' ? '' : meta.path)
const canonical = meta.canonical || url
const title = meta.path === '/' ? meta.title : `${meta.title} · UPDATED`
const ld = { '@context': 'https://schema.org', '@graph': [...siteLd(), ...(meta.jsonld || [])] }
---
<!doctype html>
<html lang="tr" data-cms={env('CMS_URL').replace(/\/$/, '') || undefined} data-base={import.meta.env.BASE_URL === '/' ? undefined : import.meta.env.BASE_URL}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={meta.description} />
  <link rel="canonical" href={canonical} />
  {meta.noindex || staging ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
  <meta property="og:site_name" content="UPDATED" />
  <meta property="og:locale" content="tr_TR" />
  <meta property="og:type" content={meta.type || 'website'} />
  <meta property="og:title" content={meta.title} />
  <meta property="og:description" content={meta.description} />
  <meta property="og:url" content={canonical} />
  {meta.image && <meta property="og:image" content={meta.image} />}
  {meta.image && <meta property="og:image:width" content="1200" />}
  {meta.image && <meta property="og:image:height" content="630" />}
  <meta name="twitter:card" content="summary_large_image" />
  {meta.published && <meta property="article:published_time" content={meta.published} />}
  {meta.modified && <meta property="article:modified_time" content={meta.modified} />}
  <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href="/marka/updated-up-black.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="UPDATED" href="/rss.xml" />
  <!-- Yazı tipleri kendi sitemizde (Google'a bağlanılmaz): public/yazi-tipleri, üretici deploy/yazi-tipi-indir.mjs -->
  <link rel="preload" href="/yazi-tipleri/ibm-plex-sans-400-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/yazi-tipleri/yazi-tipleri.css?v=20261023" />
  <script is:inline>try{var t=localStorage.getItem('up-theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}</script>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <slot name="head" />
</head>
<body class={bodyClass}>
  <a class="sr" href="#main">İçeriğe geç</a>
  <Header site={site} current={Astro.url.pathname} />
  <BreakingStrip items={hot} />
  <slot name="top" />
  <main id="main"><slot /></main>
  <Footer site={site} />
  <div class="search" id="search" role="dialog" aria-modal="true" aria-label="Arama" hidden>
    <div class="wrap">
      <form action="/ara" method="get" style="display:flex;gap:12px;align-items:center" role="search">
        <label class="sr" for="sq">Ara</label>
        <input id="sq" name="q" placeholder="Ürün, haber, kategori…" autocomplete="off" />
        <button class="ibtn" type="button" data-close-search aria-label="Kapat"><Fragment set:html={ico('x')} /></button>
      </form>
      <ul class="res" id="sres"></ul>
    </div>
  </div>
  <script>import '../scripts/site.ts'; import '../scripts/canli.ts'</script>
</body>
</html>
