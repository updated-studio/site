---
import { pageOf } from '../../../lib/format'
import ListPage from '../../../components/ListPage.astro'
import * as api from '../../../lib/api'
const a = await api.getAuthor(Astro.params.slug!)
if (!a) return new Response(null, { status: 404, statusText: 'Bulunamadı' })
const p = pageOf(Astro.params.sayfa)
if (!p) return new Response(null, { status: 404, statusText: 'Bulunamadı' })
const items = await api.getAuthorNews(a.slug, p)
---
<ListPage eyebrow={a.title || 'Yazar'} title={a.name} lead={a.bio || `${a.name} imzalı haberler.`} path={`/yazar/${a.slug}`} source={`yazar:${a.slug}`} items={items} page={p} />
