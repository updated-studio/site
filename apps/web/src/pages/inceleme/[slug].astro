---
/** İnceleme sayfası (30 Ekim 2026'dan beri şablon components/Inceleme.astro): video + puan kartı, otomatik öneriler, kısa cevap, artı/eksi. */
import Base from '../../layouts/Base.astro'
import Inceleme from '../../components/Inceleme.astro'
import InfiniteFeed from '../../components/InfiniteFeed.astro'
import * as api from '../../lib/api'
import { reviewMeta } from '../../lib/seo'
import type { Review } from '../../lib/types'
export async function getStaticPaths() {
  return (await api.allReviews()).map((r) => ({ params: { slug: r.path.split('/').pop() }, props: { r } }))
}
const { r } = Astro.props as { r: Review }
const [ads, top, videos, reels, site, oneriler, kiyaslar, fotolar] = await Promise.all([
  api.getAds(), api.getReviews(1, 6), api.getVideos(), api.getReels(), api.getSite(), api.incelemeOnerileri(r), api.allComparisons(), api.yazarFotolari(),
])
const urununKiyaslari = kiyaslar.filter((c) => c.a?.slug === r.product.slug || c.b?.slug === r.product.slug)
---
<Base meta={reviewMeta(r)}>
  <div class="wrap">
    <Inceleme r={r} oneriler={oneriler} kiyaslar={urununKiyaslari} ads={ads} top={top.filter((x) => x.id !== r.id).slice(0, 4)} fotolar={fotolar} youtube={site.youtube} />
  </div>
  <div class="wrap" style="padding-top:48px">
    <InfiniteFeed title="Okumaya devam et" source="son" items={[]} videos={videos} reels={reels} ads={ads} channel={site.youtube} profile={site.instagram} renderFirst={false} />
  </div>
</Base>
