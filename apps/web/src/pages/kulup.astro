---
/**
 * UPDATED Kulüp — fotoğraf / video / dron dersleri, simülatörler, alıştırmalar ve haftalık görevler.
 * Aynı tasarım dili, ayrı alan. Şimdilik istemci uygulaması (public/kulup/*.js); ilerleme tarayıcıda tutulur.
 * Sonraki adım: dersler Payload'daki KulupTracks/KulupQuizzes'tan, ilerleme Supabase'den (docs/kulup.md).
 */
import '../styles/brand.css'
import '../styles/kulup.css'
import { SITE } from '../lib/seo'
const meta = { title: 'UPDATED Kulüp · Fotoğraf, video ve dron dersleri', description: 'Fotoğraf, video ve dron için dersler, simülatörler, alıştırmalar ve haftalık görevler.' }
const ld = { '@context': 'https://schema.org', '@type': 'Course', name: 'UPDATED Kulüp', description: meta.description, provider: { '@type': 'Organization', name: 'UPDATED', sameAs: SITE }, inLanguage: 'tr-TR' }
---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{meta.title}</title><meta name="description" content={meta.description} />
  <link rel="canonical" href={`${SITE}/kulup`} />
  <meta property="og:title" content={meta.title} /><meta property="og:description" content={meta.description} /><meta property="og:url" content={`${SITE}/kulup`} />
  <link rel="icon" href="/marka/updated-up-black.svg" type="image/svg+xml" />
  <link rel="preload" href="/yazi-tipleri/ibm-plex-sans-400-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/yazi-tipleri/yazi-tipleri.css?v=20261023" />
  <script is:inline>try{var t=localStorage.getItem('up-theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}</script>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</head>
<body>
  <a class="sr" href="#kmain">İçeriğe geç</a>
  <header class="hdr kh" id="hdr"></header>
  <nav class="ktabs wrap" id="ktabs" aria-label="Kulüp bölümleri"></nav>
  <main id="kmain"><noscript><div class="wrap" style="padding:48px 0"><h1>UPDATED Kulüp</h1><p>Dersler ve simülatörler için JavaScript gerekir.</p></div></noscript></main>
  <footer class="ftr"><div class="wrap" style="grid-template-columns:minmax(0,1fr) auto"><div><span class="label" style="color:#B4B7BB">UPDATED Kulüp</span><p style="color:#B4B7BB;font-size:15px;margin:8px 0 0;max-width:52ch">Fotoğraf, video ve dron için dersler, simülatörler ve haftalık görevler. Sitenin parçası, ayrı bir alan.</p></div><a class="btn btn-p" href="/" style="align-self:center">updated.com.tr</a><div class="bt"><span>© {new Date().getFullYear()} UPDATED</span><span>İlerleme şimdilik bu tarayıcıda saklanır</span></div></div></footer>
  <script is:inline src="/kulup/media.js"></script>
  <script is:inline src="/kulup/logo.js"></script>
  <script is:inline src="/kulup/core.js"></script>
  <script is:inline>UP.SITE_URL = '/';</script>
  <script is:inline src="/kulup/kulup.js"></script>
  <script is:inline>UP.kulup();</script>
</body>
</html>
