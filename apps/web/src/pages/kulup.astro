---
/**
 * UPDATED Kulüp — fotoğraf / video / dron dersleri, simülatörler, alıştırmalar; haftalık görev ve yarışmalara köprü.
 * 28 Ekim 2026 (kullanıcı: "bambaşka bir sayfaymış gibi açılmasına gerek yok, mobilde geri gitme yok"): sitenin kendi üst barı ve alt bilgisiyle
 * (Base), Kulüp bölümleri üst barın altında sekme şeridi. İçerik istemci uygulaması (public/kulup/*.js); ilerleme tarayıcıda, Uper'de hesapta.
 */
import Base from '../layouts/Base.astro'
import '../styles/kulup.css'
import { SITE } from '../lib/seo'
import { getGorevler } from '../lib/api'
import { date } from '../lib/format'
const meta = { title: 'Kulüp · Fotoğraf, video ve dron dersleri', description: 'Fotoğraf, video ve dron için dersler, simülatörler, alıştırmalar ve haftalık görevler.', path: '/kulup', jsonld: [{ '@type': 'Course', name: 'UPDATED Kulüp', description: 'Fotoğraf, video ve dron için dersler, simülatörler, alıştırmalar ve haftalık görevler.', provider: { '@type': 'Organization', name: 'UPDATED', sameAs: SITE }, inLanguage: 'tr-TR' }] }
// Bu haftanın gerçek görevi (panel): Kulüp "Görevler" sekmesi ve ana sayfası gösterir, katılım /gorev'de
const simdi = Date.now(), liste = await getGorevler()
const aktif = liste.find((g) => +new Date(g.baslangic) <= simdi && simdi < +new Date(g.bitis))
const oyda = aktif ? null : liste.find((g) => +new Date(g.bitis) <= simdi && simdi < +new Date(g.oylamaBitis))
const g = aktif || oyda
const gorev = g ? { baslik: g.baslik, aciklama: g.aciklama || '', oylama: !aktif, son: date(aktif ? g.bitis : g.oylamaBitis) } : null
---
<Base meta={meta} breaking={false} bodyClass="kulup-sayfa">
  <nav class="ktabs" id="ktabs" aria-label="Kulüp bölümleri"><div class="wrap"></div></nav>
  <div id="kmain"><noscript><div class="wrap" style="padding:48px 0"><h1>UPDATED Kulüp</h1><p>Dersler ve simülatörler için JavaScript gerekir.</p></div></noscript></div>
  <script is:inline src="/kulup/media.js"></script>
  <script is:inline src="/kulup/logo.js"></script>
  <script is:inline src="/kulup/core.js"></script>
  <script is:inline set:html={`UP.SITE_URL='/';UP.GOREV=${JSON.stringify(gorev).replace(/</g, '\\u003c')};`} />
  <script is:inline src="/kulup/kulup.js"></script>
  <script is:inline>UP.kulup();</script>
  <script>import '../scripts/kulup-uye.ts'</script>
</Base>
