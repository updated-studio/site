---
import Base from '../../layouts/Base.astro'
import ArticleBody from '../../components/ArticleBody.astro'
import KunyeMini from '../../components/KunyeMini.astro'
import Ad from '../../components/Ad.astro'
import InfiniteFeed from '../../components/InfiniteFeed.astro'
import * as api from '../../lib/api'
import { newsMeta } from '../../lib/seo'
const { kategori, slug } = Astro.params
const n = await api.getNews(kategori!, slug!)
if (!n) return new Response(null, { status: 404, statusText: 'Bulunamadı' })
const [related, ads, videos, reels, site] = await Promise.all([api.getRelated(n), api.getAds(), api.getVideos(), api.getReels(), api.getSite()])
---
<Base meta={newsMeta(n)}>
  <div class="wrap with-rail">
    <ArticleBody n={n} related={related} ads={ads} />
    <div class="rail" style="padding-top:48px">
      {n.products.length > 0 && <div><h4 class="label" style="color:var(--text-3);margin:0 0 8px">Bu haberdeki ürünler · künye</h4><div class="kstack">{n.products.map((p) => <KunyeMini p={p} />)}</div></div>}
      <Ad slot="mr" ad={api.pickAd(ads, 'mr')} bare />
    </div>
  </div>
  <div class="wrap" style="padding-top:48px">
    <InfiniteFeed title="Okumaya devam et" source="son" items={[]} startPage={1} videos={videos} reels={reels} ads={ads} channel={site.youtube} profile={site.instagram} renderFirst={false} />
  </div>
</Base>
