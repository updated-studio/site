---
/**
 * Storyboard (toplantı notu 30 Ekim 2026, araç 13): kare kare çekim planı. Her karede parmakla/fareyle çizim ya da görsel, plan ölçeği,
 * kamera hareketi, açıklama ve süre; toplam süre hesaplanır. Tarayıcıda saklanır; "Görsel olarak indir" tüm planı tek PNG yapar.
 */
import AracSayfa from '../../components/AracSayfa.astro'
const OLCEK = ['Çok geniş (EWS)', 'Geniş (WS)', 'Boy (FS)', 'Orta (MS)', 'Yakın (CU)', 'Çok yakın (ECU)', 'Omuz üstü (OTS)', 'Bakış açısı (POV)', 'Kuş bakışı']
const HAREKET = ['Sabit', 'Pan', 'Tilt', 'Dolly / ileri-geri', 'Kaydırma (slider)', 'Zoom', 'Elde', 'Gimbal takip', 'Dron']
---
<AracSayfa yol="/araclar/storyboard" baslik="Storyboard" lead="Çekimini kare kare planla: her kareye çiz ya da görsel koy, plan ölçeğini ve kamera hareketini seç, ne olacağını yaz. Toplam süreyi gör, planı görsel olarak indir."
  aciklama="Online storyboard aracı: kare kare çizim, plan ölçeği, kamera hareketi, açıklama ve süre; toplam süre ve PNG olarak indirme. Ücretsiz, üyelik gerekmez.">
  <div class="sb-ust">
    <label class="sb-ad"><span class="sr">Proje adı</span><input data-sb-ad maxlength="60" placeholder="Proje adı" /></label>
    <span class="mono" data-sb-toplam></span>
    <button type="button" class="btn" data-sb-ekle>Kare ekle</button>
    <button type="button" class="btn" data-sb-indir>Görsel olarak indir</button>
  </div>
  <ol class="sb-kareler" data-sb-kareler></ol>
  <p class="arac-hesap" data-arac-hesap aria-live="polite"></p>
  <template data-sb-kalip>
    <li class="sb-kare">
      <div class="sb-tuval"><canvas width="640" height="360"></canvas><span class="sb-no"></span>
        <div class="sb-cizim"><button type="button" data-kalem aria-pressed="true">Kalem</button><button type="button" data-silgi aria-pressed="false">Silgi</button><button type="button" data-temizle>Temizle</button><label>Görsel<input type="file" accept="image/*" data-gorsel hidden /></label></div>
      </div>
      <div class="sb-alan">
        <div class="sb-iki"><label>Plan<select data-olcek>{OLCEK.map((o) => <option>{o}</option>)}</select></label><label>Hareket<select data-hareket>{HAREKET.map((o) => <option>{o}</option>)}</select></label><label>Süre (sn)<input type="number" min="0" step="0.5" value="3" data-sure inputmode="decimal" /></label></div>
        <label>Ne oluyor?<textarea rows="2" maxlength="300" data-not placeholder="ör. Konu kapıdan girer, kamera yavaşça takip eder"></textarea></label>
        <label>Ses / diyalog<input maxlength="160" data-ses placeholder="ör. Kapı gıcırtısı, müzik başlar" /></label>
        <div class="sb-tus"><button type="button" class="btn" data-yukari aria-label="Yukarı taşı">↑</button><button type="button" class="btn" data-asagi aria-label="Aşağı taşı">↓</button><button type="button" class="btn" data-kopya>Kopyala</button><button type="button" class="btn" data-sil>Sil</button></div>
      </div>
    </li>
  </template>
  <Fragment slot="nasil">
    <h2>Storyboard nasıl hazırlanır?</h2>
    <p>Storyboard, çekimin çizgi roman gibi kare kare planıdır. Her kare bir çekimi (plan) anlatır: ne görünüyor, kamera nerede ve nasıl hareket ediyor, ne kadar sürüyor. Çizim iyi olmak zorunda değil; çöp adam ve oklar ekip için yeterlidir. Önemli olan plan ölçeğinin (geniş, orta, yakın) ve hareketin net olmasıdır.</p>
    <p>Planlarını sırayla dizdikten sonra toplam süreye bak: 30 saniyelik bir reklam için 8-12 plan yaygındır. Sahada aynı mekânda geçen planları art arda çekmek zaman kazandırır; storyboard çekim sırasını ayrıca planlamana da yardım eder.</p>
    <p>Planın bu tarayıcıda saklanır; Uper hesabınla giriş yaptıysan hesabına da kaydedilir, başka cihazdan açınca kaldığın yerden devam edersin.</p>
  </Fragment>
</AracSayfa>
<style is:global>
  .sb-ust{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
  .sb-ad{flex:1;min-width:200px}
  .sb-ad input,.sb-alan input,.sb-alan select,.sb-alan textarea{width:100%;min-width:0;min-height:40px;padding:8px 10px;font:inherit;font-size:15px;color:var(--text);background:var(--bg);border:1px solid var(--input);border-radius:var(--r-dugme,0)}
  .sb-ad input{font-size:18px;font-weight:600}
  .sb-kareler{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:20px}
  .sb-kare{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:16px;padding:14px;border:1px solid var(--line);border-radius:var(--r-kart,0);background:var(--surface)}
  .sb-tuval{position:relative;display:flex;flex-direction:column;gap:8px}
  .sb-tuval canvas{width:100%;height:auto;aspect-ratio:16/9;border-radius:var(--r-etiket,0);background:#fff;touch-action:none;cursor:crosshair;border:1px solid var(--line)}
  .sb-no{position:absolute;left:8px;top:8px;padding:2px 8px;border-radius:6px;background:var(--orange);color:#111;font-family:var(--f-head);font-weight:900;font-size:18px}
  .sb-cizim{display:flex;gap:6px;flex-wrap:wrap}
  .sb-cizim button,.sb-cizim label{min-height:36px;padding:0 12px;display:inline-flex;align-items:center;border:1px solid var(--line);border-radius:var(--r-dugme,0);background:none;color:var(--text);font:600 13px/1 var(--f-body);cursor:pointer}
  .sb-cizim [aria-pressed=true]{background:var(--text);color:var(--bg)}
  .sb-alan{display:flex;flex-direction:column;gap:10px;min-width:0}
  .sb-alan label{display:flex;flex-direction:column;gap:4px;font-size:13px;font-weight:600;color:var(--text-2)}
  .sb-iki{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr) 90px;gap:8px}
  .sb-tus{display:flex;gap:6px;flex-wrap:wrap;margin-top:auto}
  .sb-tus .btn{min-height:36px;padding:0 12px;font-size:13px}
  @media (max-width:760px){.sb-kare{grid-template-columns:minmax(0,1fr)}.sb-iki{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.sb-iki label:last-child{grid-column:1/-1}}
</style>
<script>
  import { aracHesabi } from '../../scripts/araclar/hesap'
  type Kare = { cizim: string; olcek: string; hareket: string; sure: number; not: string; ses: string }
  const $ = <T extends Element>(s: string, k: ParentNode = document) => k.querySelector<T>(s)!
  const liste = $<HTMLOListElement>('[data-sb-kareler]'), kalip = $<HTMLTemplateElement>('[data-sb-kalip]'), adIn = $<HTMLInputElement>('[data-sb-ad]')
  const bos = (): Kare => ({ cizim: '', olcek: 'Geniş (WS)', hareket: 'Sabit', sure: 3, not: '', ses: '' })
  let veri: { ad: string; kareler: Kare[] } = { ad: '', kareler: [bos(), bos(), bos()] }
  try { const s = localStorage.getItem('up-storyboard'); if (s) veri = JSON.parse(s) } catch { /* depolama kapalı */ }
  let zaman = 0
  const kaydet = () => { clearTimeout(zaman); zaman = window.setTimeout(() => { try { localStorage.setItem('up-storyboard', JSON.stringify(veri)) } catch { /* dolu olabilir: büyük görseller */ } hesap?.kaydet() }, 300) }
  let hesap: { kaydet: () => void } | null = null
  const toplam = () => { const t = veri.kareler.reduce((s, k) => s + (Number(k.sure) || 0), 0); $('[data-sb-toplam]').textContent = `${veri.kareler.length} kare · ${t.toLocaleString('tr-TR')} sn` }
  function kareCiz(li: HTMLElement, k: Kare, i: number) {
    $('.sb-no', li).textContent = String(i + 1)
    const cv = $<HTMLCanvasElement>('canvas', li), x = cv.getContext('2d')!
    x.fillStyle = '#fff'; x.fillRect(0, 0, 640, 360)
    if (k.cizim) { const im = new Image(); im.onload = () => x.drawImage(im, 0, 0, 640, 360); im.src = k.cizim }
    // Üçte bir kılavuz çizgileri (çizime işlenmez; yalnız ilk açılışta, boş karede)
    else { x.strokeStyle = '#E5E7EB'; x.lineWidth = 1; for (const p of [213, 427]) { x.beginPath(); x.moveTo(p, 0); x.lineTo(p, 360); x.stroke() } for (const p of [120, 240]) { x.beginPath(); x.moveTo(0, p); x.lineTo(640, p); x.stroke() } }
    $<HTMLSelectElement>('[data-olcek]', li).value = k.olcek; $<HTMLSelectElement>('[data-hareket]', li).value = k.hareket
    $<HTMLInputElement>('[data-sure]', li).value = String(k.sure); $<HTMLTextAreaElement>('[data-not]', li).value = k.not; $<HTMLInputElement>('[data-ses]', li).value = k.ses
    let silgi = false, ciziyor = false
    const nokta = (e: PointerEvent) => { const r = cv.getBoundingClientRect(); return [((e.clientX - r.left) / r.width) * 640, ((e.clientY - r.top) / r.height) * 360] }
    cv.addEventListener('pointerdown', (e) => { ciziyor = true; cv.setPointerCapture(e.pointerId); const [a, b] = nokta(e); x.beginPath(); x.moveTo(a, b) })
    cv.addEventListener('pointermove', (e) => { if (!ciziyor) return; const [a, b] = nokta(e); x.lineTo(a, b); x.strokeStyle = silgi ? '#fff' : '#111'; x.lineWidth = silgi ? 22 : 3; x.lineCap = 'round'; x.lineJoin = 'round'; x.stroke() })
    const bitir = () => { if (!ciziyor) return; ciziyor = false; k.cizim = cv.toDataURL('image/webp', 0.7); kaydet() }
    cv.addEventListener('pointerup', bitir); cv.addEventListener('pointercancel', bitir)
    const kal = $<HTMLButtonElement>('[data-kalem]', li), sil = $<HTMLButtonElement>('[data-silgi]', li)
    kal.onclick = () => { silgi = false; kal.setAttribute('aria-pressed', 'true'); sil.setAttribute('aria-pressed', 'false') }
    sil.onclick = () => { silgi = true; sil.setAttribute('aria-pressed', 'true'); kal.setAttribute('aria-pressed', 'false') }
    $<HTMLButtonElement>('[data-temizle]', li).onclick = () => { k.cizim = ''; kaydet(); ciz() }
    $<HTMLInputElement>('[data-gorsel]', li).onchange = (e) => {
      const f = (e.target as HTMLInputElement).files?.[0]; if (!f) return
      const im = new Image(); im.onload = () => { const o = Math.max(640 / im.width, 360 / im.height), w = im.width * o, h = im.height * o; x.drawImage(im, (640 - w) / 2, (360 - h) / 2, w, h); k.cizim = cv.toDataURL('image/webp', 0.7); kaydet(); URL.revokeObjectURL(im.src) }
      im.src = URL.createObjectURL(f)
    }
    li.oninput = (e) => {
      const t = e.target as HTMLElement & { value: string }
      if (t.matches('[data-olcek]')) k.olcek = t.value; else if (t.matches('[data-hareket]')) k.hareket = t.value
      else if (t.matches('[data-sure]')) { k.sure = Math.max(0, Number(t.value) || 0); toplam() } else if (t.matches('[data-not]')) k.not = t.value; else if (t.matches('[data-ses]')) k.ses = t.value
      kaydet()
    }
    const tasi = (d: number) => { const j = i + d; if (j < 0 || j >= veri.kareler.length) return; [veri.kareler[i], veri.kareler[j]] = [veri.kareler[j], veri.kareler[i]]; kaydet(); ciz() }
    $<HTMLButtonElement>('[data-yukari]', li).onclick = () => tasi(-1)
    $<HTMLButtonElement>('[data-asagi]', li).onclick = () => tasi(1)
    $<HTMLButtonElement>('[data-kopya]', li).onclick = () => { veri.kareler.splice(i + 1, 0, { ...k }); kaydet(); ciz() }
    $<HTMLButtonElement>('[data-sil]', li).onclick = () => { veri.kareler.splice(i, 1); if (!veri.kareler.length) veri.kareler.push(bos()); kaydet(); ciz() }
  }
  function ciz() {
    liste.innerHTML = ''
    veri.kareler.forEach((k, i) => { const li = kalip.content.firstElementChild!.cloneNode(true) as HTMLElement; liste.append(li); kareCiz(li, k, i) })
    adIn.value = veri.ad; toplam()
  }
  adIn.addEventListener('input', () => { veri.ad = adIn.value; kaydet() })
  $('[data-sb-ekle]').addEventListener('click', () => { veri.kareler.push(bos()); kaydet(); ciz(); liste.lastElementChild?.scrollIntoView({ behavior: 'smooth', block: 'center' }) })
  // Tüm planı tek görsel: üç sütunlu sayfa, her karenin altında plan, hareket, süre ve açıklama
  $('[data-sb-indir]').addEventListener('click', async () => {
    const S = 3, W = 400, H = 225, P = 24, Y = 120, satir = Math.ceil(veri.kareler.length / S)
    const c = document.createElement('canvas'); c.width = P + S * (W + P); c.height = 90 + satir * (H + Y + P); const x = c.getContext('2d')!
    x.fillStyle = '#fff'; x.fillRect(0, 0, c.width, c.height); x.fillStyle = '#111'; x.font = '700 28px "IBM Plex Sans", Arial, sans-serif'
    x.fillText(veri.ad || 'Storyboard', P, 50); x.font = '14px "IBM Plex Mono", monospace'; x.fillStyle = '#666'; x.fillText($('[data-sb-toplam]').textContent + ' · updated.com.tr/araclar/storyboard', P, 74)
    const sar = (t: string, mx: number) => { const k = t.split(' '), s: string[] = []; let l = ''; for (const w of k) { if (x.measureText(l + w).width > mx) { s.push(l.trim()); l = '' } l += w + ' ' } if (l.trim()) s.push(l.trim()); return s.slice(0, 3) }
    for (const [i, k] of veri.kareler.entries()) {
      const cx = P + (i % S) * (W + P), cy = 90 + Math.floor(i / S) * (H + Y + P)
      x.strokeStyle = '#ccc'; x.strokeRect(cx, cy, W, H)
      if (k.cizim) await new Promise<void>((ok) => { const im = new Image(); im.onload = () => { x.drawImage(im, cx, cy, W, H); ok() }; im.onerror = () => ok(); im.src = k.cizim })
      x.fillStyle = '#FF6B1A'; x.fillRect(cx, cy, 34, 26); x.fillStyle = '#111'; x.font = '700 16px "IBM Plex Mono", monospace'; x.fillText(String(i + 1), cx + 8, cy + 19)
      x.font = '600 13px "IBM Plex Mono", monospace'; x.fillStyle = '#333'; x.fillText(`${k.olcek} · ${k.hareket} · ${k.sure} sn`, cx, cy + H + 20)
      x.font = '14px "IBM Plex Sans", Arial, sans-serif'; x.fillStyle = '#111'; sar(k.not, W).forEach((s, j) => x.fillText(s, cx, cy + H + 42 + j * 18))
      if (k.ses) { x.fillStyle = '#666'; x.fillText('♪ ' + k.ses.slice(0, 60), cx, cy + H + 102) }
    }
    const a = document.createElement('a'); a.download = `${(veri.ad || 'storyboard').replace(/[^\p{L}\p{N}-]+/gu, '-')}.png`; a.href = c.toDataURL('image/png'); a.click()
  })
  ciz()
  hesap = aracHesabi('storyboard', () => veri, (v) => { veri = v; ciz() })
</script>
