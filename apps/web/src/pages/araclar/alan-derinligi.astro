---
/**
 * Alan derinliği + hiperfokal + kadraj (toplantı notu 30 Ekim 2026, araç 3): sensör, odak uzaklığı, diyafram, konu mesafesi →
 * netliğin başladığı ve bittiği mesafe, toplam derinlik, hiperfokal mesafe, o mesafede kadrajın genişliği. Görsel: mesafe ekseninde net alan.
 */
import AracSayfa from '../../components/AracSayfa.astro'
// [ad, genişlik mm, yükseklik mm] — karışıklık çemberi köşegen/1500 (Zeiss formülü yerine yaygın kabul)
const SENSOR: [string, number, number][] = [
  ['Full frame (35 mm)', 36, 24], ['APS-C (Sony, Nikon, Fujifilm)', 23.5, 15.6], ['APS-C (Canon)', 22.3, 14.9], ['Micro Four Thirds', 17.3, 13],
  ['1 inç (kompakt, dron)', 13.2, 8.8], ['Orta format (44×33)', 43.8, 32.9], ['Süper 35 (sinema)', 24.9, 14],
]
const DIYAFRAM = ['1.2', '1.4', '1.8', '2', '2.8', '4', '5.6', '8', '11', '16', '22']
---
<AracSayfa yol="/araclar/alan-derinligi" baslik="Alan derinliği hesaplayıcı" lead="Sensörünü, lensini, diyaframı ve konuya uzaklığını seç; netliğin nerede başlayıp nerede bittiğini, hiperfokal mesafeyi ve kadrajın genişliğini gör."
  aciklama="Alan derinliği (DoF) ve hiperfokal mesafe hesaplayıcı: full frame, APS-C, MFT için net alanın başı ve sonu, kadraj genişliği, görüş açısı. Ücretsiz.">
  <form class="arac-form" data-ad onsubmit="return false">
    <label for="ad-sensor">Sensör<select id="ad-sensor">{SENSOR.map(([ad, w, h], i) => <option value={`${w}x${h}`} selected={i === 0}>{ad}</option>)}</select></label>
    <label for="ad-f">Odak uzaklığı (mm)<input id="ad-f" type="number" min="4" max="1200" step="1" value="50" inputmode="numeric" /></label>
    <label for="ad-n">Diyafram<select id="ad-n">{DIYAFRAM.map((n) => <option value={n} selected={n === '2.8'}>f/{n.replace('.', ',')}</option>)}</select></label>
    <label for="ad-s">Konuya uzaklık (metre)<input id="ad-s" type="number" min="0.1" max="1000" step="0.1" value="3" inputmode="decimal" /></label>
  </form>
  <input class="ad-kaydir" type="range" min="0" max="1000" value="400" data-ad-kaydir aria-label="Konuya uzaklık (kaydır)" />
  <figure class="ad-eksen" aria-hidden="true"><svg data-ad-svg viewBox="0 0 800 150"></svg></figure>
  <div class="arac-sonuc" data-sonuc aria-live="polite"></div>
  <Fragment slot="nasil">
    <h2>Alan derinliği nedir?</h2>
    <p>Alan derinliği, odaklandığın noktanın önünde ve arkasında "yeterince net" görünen bölgedir. Dört şey belirler: <b>diyafram</b> (f sayısı büyüdükçe derinlik artar), <b>odak uzaklığı</b> (uzun lensle azalır), <b>konuya uzaklık</b> (yaklaştıkça hızla daralır) ve <b>sensör boyu</b> (aynı kadrajda küçük sensör daha derin netlik verir).</p>
    <p><b>Hiperfokal mesafe</b>, sonsuzu hâlâ net tutan en yakın odak noktasıdır. Bu mesafeye odaklanırsan netlik, hiperfokal mesafenin yarısından sonsuza kadar uzanır; manzara ve sokak fotoğrafında ön planı da arka planı da net tutmanın yoludur.</p>
    <p>Hesapta karışıklık çemberi sensör köşegeninin 1/1500'ü alınır (full frame'de 0,029 mm): fotoğraf ekranda ya da 20×30 cm baskıda normal mesafeden bakıldığında net görünen sınır. Büyük baskı ya da piksel piksel inceleme için gerçek derinlik daha dardır.</p>
  </Fragment>
</AracSayfa>
<style is:global>
  .ad-kaydir{width:100%;accent-color:var(--blue)}
  .ad-eksen{margin:0;padding:12px 0;border-radius:var(--r-kart,0);background:var(--surface-2)}
  .ad-eksen svg{display:block;width:100%;height:150px}
  [data-sonuc] .arac-ikili{grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr))}
  [data-sonuc] .arac-buyuk b{font-size:clamp(24px,3vw,30px)}
</style>
<script>
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!
  const sensor = $<HTMLSelectElement>('#ad-sensor'), fIn = $<HTMLInputElement>('#ad-f'), nIn = $<HTMLSelectElement>('#ad-n'), sIn = $<HTMLInputElement>('#ad-s')
  const kaydir = $<HTMLInputElement>('[data-ad-kaydir]'), svg = $('[data-ad-svg]'), out = $('[data-sonuc]')
  // Kaydırıcı logaritmik: 0,2 m – 200 m
  const kayToM = (v: number) => 0.2 * Math.pow(1000, v / 1000), mToKay = (m: number) => Math.round((Math.log(m / 0.2) / Math.log(1000)) * 1000)
  const m = (x: number) => (x === Infinity ? '∞' : x >= 100 ? `${Math.round(x).toLocaleString('tr-TR')} m` : x >= 1 ? `${x.toLocaleString('tr-TR', { maximumFractionDigits: 2 })} m` : `${Math.round(x * 100)} cm`)
  function hesapla() {
    const [w, h] = sensor.value.split('x').map(Number), f = Math.max(1, Number(fIn.value) || 50), N = Number(nIn.value), s = Math.max(0.05, Number(sIn.value) || 1) * 1000
    const c = Math.hypot(w, h) / 1500, H = (f * f) / (N * c) + f
    const yakin = (s * (H - f)) / (H + s - 2 * f), uzak = s >= H ? Infinity : (s * (H - f)) / (H - s)
    const toplam = uzak - yakin, on = s - yakin, arka = uzak - s
    const genislik = (w * s) / f, yukseklik = (h * s) / f, aci = (2 * Math.atan(w / (2 * f)) * 180) / Math.PI, crop = 43.27 / Math.hypot(w, h)
    out.innerHTML = `<div class="arac-ikili">
        <div class="arac-buyuk"><span class="label">Net alan</span><b>${m(yakin / 1000)} – ${m(uzak / 1000)}</b><span class="meta">toplam ${toplam === Infinity ? 'sonsuza kadar' : m(toplam / 1000)}${toplam !== Infinity ? ` · önde ${Math.round((on / toplam) * 100)}%, arkada ${Math.round((arka / toplam) * 100)}%` : ''}</span></div>
        <div class="arac-buyuk"><span class="label">Hiperfokal mesafe</span><b>${m(H / 1000)}</b><span class="meta">buraya odaklan: ${m(H / 2000)}'den sonsuza net</span></div>
        <div class="arac-buyuk"><span class="label">Kadraj (konu mesafesinde)</span><b>${m(genislik / 1000)} × ${m(yukseklik / 1000)}</b><span class="meta">yatay görüş açısı ${aci.toFixed(1).replace('.', ',')}°</span></div>
        <div class="arac-buyuk"><span class="label">Full frame karşılığı</span><b>${Math.round(f * crop)} mm · f/${(N * crop).toFixed(1).replace('.', ',')}</b><span class="meta">aynı kadraj ve aynı derinlik için (krop ${crop.toFixed(2).replace('.', ',')}×)</span></div>
      </div>`
    eksen(s / 1000, yakin / 1000, uzak / 1000)
  }
  // Mesafe ekseni: makine solda, konu ortaya yakın; net alan mavi bant, sonsuz ise sağa taşar
  function eksen(s: number, y: number, u: number) {
    // Çizim kutunun gerçek genişliğinde yapılır: telefonda yazılar sıkışmaz
    const W = Math.max(300, Math.round(svg.getBoundingClientRect().width) || 800), R = W - 10, L = W - 60
    svg.setAttribute('viewBox', `0 0 ${W} 150`)
    const max = Math.max(s * 2.2, Math.min(u === Infinity ? s * 3 : u * 1.15, s * 6)), X = (d: number) => 40 + (Math.min(d, max) / max) * L
    const x1 = X(y), x2 = u === Infinity ? R : X(u), xs = X(s)
    const isaret = (ust: number) => { const t = [0.5, 1, 2, 5, 10, 20, 50, 100, 200, 500].filter((v) => v < ust); return t.filter((_, i) => i % Math.ceil(t.length / 6) === 0) }
    svg.innerHTML = `
      <rect x="${x1}" y="34" width="${Math.max(2, x2 - x1)}" height="70" rx="6" fill="var(--blue)" opacity=".28"/>
      <line x1="${x1}" y1="30" x2="${x1}" y2="108" stroke="var(--blue)" stroke-width="2"/>${u === Infinity ? '' : `<line x1="${x2}" y1="30" x2="${x2}" y2="108" stroke="var(--blue)" stroke-width="2"/>`}
      <line x1="40" y1="118" x2="${R}" y2="118" stroke="var(--text-3)" stroke-width="1"/>
      ${isaret(max).map((d) => `<line x1="${X(d)}" y1="114" x2="${X(d)}" y2="122" stroke="var(--text-3)"/><text x="${X(d)}" y="140" fill="var(--text-3)" font-size="12" font-family="IBM Plex Mono, monospace" text-anchor="middle">${d} m</text>`).join('')}
      <g transform="translate(6 58)" fill="var(--text)"><rect width="26" height="18" rx="3"/><rect x="26" y="5" width="8" height="8" rx="1"/></g>
      <g transform="translate(${xs - 9} 44)" fill="var(--orange)"><circle cx="9" cy="8" r="8"/><rect x="2" y="18" width="14" height="32" rx="6"/></g>
      <text x="${xs}" y="24" fill="var(--text)" font-size="13" font-family="IBM Plex Mono, monospace" text-anchor="middle">${m(s)}</text>
      ${u === Infinity ? `<text x="${R - 4}" y="74" fill="var(--blue)" font-size="20" font-family="IBM Plex Mono, monospace" text-anchor="end">∞</text>` : ''}`
  }
  sIn.addEventListener('input', () => { kaydir.value = String(mToKay(Number(sIn.value) || 1)); hesapla() })
  kaydir.addEventListener('input', () => { const v = kayToM(Number(kaydir.value)); sIn.value = String(v < 10 ? Math.round(v * 10) / 10 : Math.round(v)); hesapla() })
  document.querySelector('[data-ad]')!.addEventListener('input', hesapla)
  let son = 0; window.addEventListener('resize', () => { cancelAnimationFrame(son); son = requestAnimationFrame(hesapla) })
  kaydir.value = String(mToKay(3)); hesapla()
</script>
