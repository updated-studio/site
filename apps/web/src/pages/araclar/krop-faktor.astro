---
import AracSayfa from '../../components/AracSayfa.astro'
const SENSOR: [string, number][] = [['Full frame (35 mm)', 1], ['APS-C · Sony, Nikon, Fujifilm (1,5x)', 1.5], ['APS-C · Canon (1,6x)', 1.6], ['Micro 4/3 (2x)', 2], ['1 inç (2,7x)', 2.7], ['Orta format · Fujifilm GFX (0,79x)', 0.79], ['Super 35 sinema (1,43x)', 1.43], ['Telefon ana kamera (~3,5x)', 3.5]]
---
<AracSayfa yol="/araclar/krop-faktor" baslik="Krop faktör hesaplayıcı" lead="Lensinin farklı sensörlerde full frame karşılığı kaç mm, diyaframın alan derinliği karşılığı ne?"
  aciklama="Krop faktör hesaplayıcı: APS-C, Micro 4/3, 1 inç ve orta format için odak uzaklığı ve diyafram full frame karşılığı. Ücretsiz.">
  <form class="arac-form" data-krop onsubmit="return false">
    <label for="kr-sensor">Sensör<select id="kr-sensor">{SENSOR.map(([a, k]) => <option value={k} selected={k === 1.5}>{a}</option>)}</select></label>
    <label for="kr-odak">Odak uzaklığı (mm)<input id="kr-odak" type="number" inputmode="decimal" min="1" max="2000" value="35" /></label>
    <label for="kr-f">Diyafram (f/)<input id="kr-f" type="number" inputmode="decimal" min="0.7" max="64" step="0.1" value="1.8" /></label>
  </form>
  <div class="arac-sonuc" data-sonuc aria-live="polite"></div>
  <Fragment slot="nasil">
    <h2>Krop faktör ne işe yarar?</h2>
    <p>Küçük sensör, lensin oluşturduğu görüntünün ortasını kırpar; bu yüzden aynı lens daha dar açı gösterir. 35 mm lens APS-C'de (1,5x) yaklaşık 52 mm'lik bir full frame lens gibi kadraj verir.</p>
    <p>Alan derinliği de benzer şekilde değişir: aynı kadrajı yakalarken f/1.8, APS-C'de full frame'deki f/2.7 kadar arka plan bulanıklığı verir. Pozlama (parlaklık) ise değişmez; f/1.8 her sensörde f/1.8 kadar ışık toplar.</p>
  </Fragment>
</AracSayfa>
<script>
  const f = document.querySelector<HTMLFormElement>('[data-krop]')!, out = document.querySelector<HTMLElement>('[data-sonuc]')!
  const sayi = (n: number, b = 0) => n.toLocaleString('tr-TR', { maximumFractionDigits: b })
  function ciz() {
    const k = Number((f.querySelector('#kr-sensor') as HTMLSelectElement).value), mm = Number((f.querySelector('#kr-odak') as HTMLInputElement).value), fs = Number((f.querySelector('#kr-f') as HTMLInputElement).value)
    if (!mm || !fs) { out.innerHTML = '<p class="meta">Odak uzaklığı ve diyaframı yaz.</p>'; return }
    const fov = (2 * Math.atan(43.27 / (2 * mm * k)) * 180) / Math.PI
    out.innerHTML = `<div class="arac-ikili"><div class="arac-buyuk"><span class="label">Full frame karşılığı</span><b>${sayi(mm * k)} mm</b><span class="meta">Köşegen görüş açısı ${sayi(fov, 1)}°</span></div>
      <div class="arac-buyuk"><span class="label">Alan derinliği karşılığı</span><b>f/${sayi(fs * k, 1)}</b><span class="meta">Pozlama değişmez: f/${sayi(fs, 1)}</span></div></div>`
  }
  f.addEventListener('input', ciz); ciz()
</script>
