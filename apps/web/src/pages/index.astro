---
/**
 * Ana sayfa (Fatih, 26 Ekim 2026): manşet (13, A biçimi) + Reels + dikey afiş → yatay reklam → video haberler → son haberler → incelemeler →
 * kıyasla → radar / kıyas robotu / 60 saniye / konular (yanda en çok okunanlar, haftalık görev, reklam) → künyeler → araçlar → kulüp → sonsuz akış.
 * 28 Ekim 2026 (kullanıcı: "ana ekranın devamını ana ekrana uyacak şekilde doldur"): Kıyasla, Konular, Araçlar, Kulüp bölümleri ve haftalık görev
 * kartı eklendi; veri olmayan bölüm basılmaz, numaralar sırayla verilir.
 */
import Base from '../layouts/Base.astro'
import Manset from '../components/hero/Manset.astro'
import CardStd from '../components/CardStd.astro'
import EnCokOkunan from '../components/EnCokOkunan.astro'
import Ad from '../components/Ad.astro'
import VideoDuvar from '../components/VideoDuvar.astro'
import Radar from '../components/modules/Radar.astro'
import KiyasRobotu from '../components/modules/KiyasRobotu.astro'
import Altmis from '../components/modules/Altmis.astro'
import KunyeRafi from '../components/modules/KunyeRafi.astro'
import KiyasBaslat from '../components/modules/KiyasBaslat.astro'
import GorevKarti from '../components/modules/GorevKarti.astro'
import AracRafi from '../components/modules/AracRafi.astro'
import KulupPano from '../components/modules/KulupPano.astro'
import InfiniteFeed from '../components/InfiniteFeed.astro'
import * as api from '../lib/api'
import type { News } from '../lib/types'
import '../styles/kiyas.css'

const [home, latest, reviews, videos, reels, ads, radar, products, site, youtube, katalog, kategoriler, gorevler] = await Promise.all([
  api.getHome(), api.getLatest(1, 40), api.getReviews(1, 4), api.getVideos(), api.getReels(), api.getAds(), api.getRadar(), api.getProducts(12), api.getSite(), api.getYoutube(), api.kunyeKatalog(), api.getCategories(), api.getGorevler(),
])
// Videolar: kısa olanlar "Son videolar" sütununa (Instagram Reels yoksa), uzunlar "Video haberler" duvarına; paneldeki videolar önce
const shorts = youtube.filter((v) => v.short)
const uzun = [...videos, ...youtube.filter((v) => !v.short && !videos.some((p) => p.youtubeId === v.youtubeId))]
const m = { radar: true, kiyasRobotu: true, altmisSaniye: true, kunyeRafi: true, videolar: true, reels: true, cokOkunan: true, ...home.modules }
// Manşet: editörün seçtikleri (en çok 13), eksik kalan yerler en yeni haberlerle
const secilen = home.hero.slice(0, 13)
const anahtar = (x: { kind: string; id: string }) => x.kind + x.id
const kullanilan = new Set(secilen.map(anahtar))
const slides = [...secilen, ...latest.filter((n) => !kullanilan.has(anahtar(n)))].slice(0, 13)
slides.forEach((s) => kullanilan.add(anahtar(s)))
const rest = latest.filter((n) => !kullanilan.has(anahtar(n)))
// Bölüm numaraları basılan sıraya göre (veri olmayan bölüm atlanır, numara boşluk bırakmaz)
let sayac = 0
const no = () => String(++sayac).padStart(2, '0')
const radarVar = m.radar && radar.length > 0
const robotVar = m.kiyasRobotu && products.filter((p) => (p.specs || []).some((s) => s.value)).length >= 2
const meta = { title: 'UPDATED · Teknoloji haberleri, incelemeler ve karşılaştırmalar', description: site.tagline, path: '/' }
---
<Base meta={meta}>
  <h1 class="sr">UPDATED · Teknoloji haberleri, incelemeler ve karşılaştırmalar</h1>
  <section class="sec" style="padding-top:24px">
    <div class="wrap"><Manset slides={slides} reels={m.reels ? reels : []} shorts={shorts} ad={api.pickAd(ads, 'hp')} instagram={site.instagram} youtube={site.youtube} /></div>
  </section>
  <Ad slot="lb" ad={api.pickAd(ads, 'lb')} />

  {m.videolar && uzun.length > 0 && <section class="sec"><div class="wrap"><VideoDuvar videos={uzun} channel={site.youtube} /></div></section>}

  <section class="sec"><div class="wrap">
    <div class="sh"><h2><span class="no">{no()}</span>Son haberler</h2><a class="btn-t btn" href="/haberler">Tümü</a></div>
    <div class="grid4">{rest.slice(0, 4).map((n) => <CardStd item={n} />)}</div>
  </div></section>

  <Ad slot="lb" ad={api.pickAd(ads, 'lb', 1)} />

  {reviews.length > 0 && <section class="sec"><div class="wrap">
    <div class="sh"><h2><span class="no">{no()}</span>İncelemeler</h2><a class="btn-t btn" href="/inceleme">Tümü</a></div>
    <div class="grid4">{reviews.slice(0, 4).map((r) => <CardStd item={r} />)}</div>
  </div></section>}

  {katalog.length >= 2 && <section class="sec"><div class="wrap"><KiyasBaslat katalog={katalog} no={no()} /></div></section>}

  <section class="sec"><div class="wrap with-rail">
    <div class="ana-sol">
      {robotVar && <div><KiyasRobotu products={products} no={no()} /></div>}
      {m.altmisSaniye && <div><Altmis items={latest} no={no()} /></div>}
      {/* Gündemden: sağ sütun uzun kaldığında solda boşluk açılmasın; "Son haberler"in devamı, sonsuz akış 21. haberden başlıyor */}
      {rest.length > 4 && <div><div class="sh"><h2><span class="no">{no()}</span>Gündemden</h2><a class="btn-t btn" href="/haberler">Tümü</a></div><div class="grid-yatay">{rest.slice(4, 10).map((n) => <CardStd item={n} />)}</div></div>}
    </div>
    <div class="rail">
      {/* Çıkış radarı sağ sütunun başında (30 Ekim 2026, toplantı notu) */}
      {radarVar && <Radar items={radar} />}
      {m.cokOkunan && <EnCokOkunan fallback={latest} />}
      <GorevKarti gorevler={gorevler} />
      <Ad slot="mr" ad={api.pickAd(ads, 'mr', 1)} bare />
    </div>
  </div></section>

  <section class="sec"><div class="wrap"><AracRafi no={no()} /></div></section>

  <section class="sec"><div class="wrap"><KulupPano kulupUrl={site.kulupUrl} no={no()} /></div></section>

  {/* Künyeler en altta (30 Ekim 2026, kullanıcı) */}
  {m.kunyeRafi && products.length > 0 && <section class="sec"><div class="wrap"><KunyeRafi products={products} /></div></section>}

  <section class="sec"><div class="wrap">
    <InfiniteFeed title="Daha fazla haber" source="son" items={[]} startPage={2} videos={videos} reels={reels} ads={ads} channel={site.youtube} profile={site.instagram} renderFirst={false} />
  </div></section>
</Base>
<style is:global>
  /* Sol sütundaki modüller arası boşluk tek yerden (Altmis kendi üst boşluğunu da taşıyordu) */
  .ana-sol{display:flex;flex-direction:column;gap:48px;min-width:0}
  .ana-sol > div{min-width:0}
  .ana-sol .sh{margin-top:0!important}
  .ana-sol .grid3{margin-bottom:0!important}
</style>
