---
/**
 * Ana sayfa (7 Kasım 2026, taslak claude.ai/artifact/SobwbxHLgDSr4QgNN2yfCx sürüm 3, kullanıcı onayı "kur"):
 * manşet + Reels → haberlerin devamı (6 haberlik şerit, "Daha fazlası"; yanda Gündemde / Çıkış radarı) → günün özeti (dönen prizma, sesli bülten)
 * → videolar → incelemeler (büyük öne çıkan + yan liste) → kıyas robotu (Versus düzeni) → kategoriler (künye rafının yerine).
 * Dikey afiş (hp) ve sağ sütun reklamı yeni düzende yok; yatay reklamlar ve telefondaki reklam alanları yerinde. Veri olmayan bölüm basılmaz.
 * Önceki düzen (26 Ekim – 7 Kasım 2026) git geçmişinde.
 */
import Base from '../layouts/Base.astro'
import Manset from '../components/hero/Manset.astro'
import Ad from '../components/Ad.astro'
import MobilAlan from '../components/MobilAlan.astro'
import VideoDuvar from '../components/VideoDuvar.astro'
import Devam from '../components/ana/Devam.astro'
import Ozet from '../components/ana/Ozet.astro'
import Incelemeler from '../components/ana/Incelemeler.astro'
import Versus from '../components/ana/Versus.astro'
import TurRafi from '../components/ana/TurRafi.astro'
import * as api from '../lib/api'
import '../styles/ana.css'

const [home, latest, reviews, incHaber, videos, reels, ads, radar, site, youtube, katalog, kiyaslar, okunan] = await Promise.all([
  api.getHome(), api.getLatest(1, 40), api.getReviews(1, 5), api.getIncelemeHaberleri(8), api.getVideos(), api.getReels(), api.getAds(), api.getRadar(), api.getSite(), api.getYoutube(), api.kunyeKatalog(), api.getComparisons(), api.getMostRead(3, '48s'),
])
// Videolar: kısa olanlar Reels sütununa (Instagram Reels yoksa), uzunlar "Videolar" duvarına; paneldeki videolar önce
const shorts = youtube.filter((v) => v.short)
const uzun = [...videos, ...youtube.filter((v) => !v.short && !videos.some((p) => p.youtubeId === v.youtubeId))]
const m = { radar: true, kiyasRobotu: true, altmisSaniye: true, kunyeRafi: true, videolar: true, reels: true, cokOkunan: true, ...home.modules }
// Manşet: editörün seçtikleri (en çok 13), eksik kalan yerler en yeni haberlerle
const secilen = home.hero.slice(0, 13)
const anahtar = (x: { kind: string; id: string }) => x.kind + x.id
const kullanilan = new Set(secilen.map(anahtar))
const slides = [...secilen, ...latest.filter((n) => !kullanilan.has(anahtar(n)))].slice(0, 13)
slides.forEach((s) => kullanilan.add(anahtar(s)))
const rest = latest.filter((n) => !kullanilan.has(anahtar(n)))
const incelemeler = [...reviews, ...incHaber.filter((n) => n.label !== 'rehber')].slice(0, 5)
let sayac = 0
const no = () => String(++sayac).padStart(2, '0')
const meta = { title: 'UPDATED · Teknoloji haberleri, incelemeler ve karşılaştırmalar', description: site.tagline, path: '/' }
---
<Base meta={meta} yanEv>
  <h1 class="sr">UPDATED · Teknoloji haberleri, incelemeler ve karşılaştırmalar</h1>
  <section class="sec" style="padding-top:24px"><div class="wrap">
    <Manset slides={slides} reels={m.reels ? reels : []} shorts={shorts} ad={null} afissiz instagram={site.instagram} youtube={site.youtube} />
    <Devam haberler={rest} gundem={m.cokOkunan ? (okunan.length ? okunan : rest.slice(6)) : []} radar={m.radar ? radar : []} />
  </div></section>
  <Ad slot="lb" ad={api.pickAd(ads, 'lb')} />

  {m.altmisSaniye && <section class="sec"><div class="wrap"><Ozet items={latest} /></div></section>}

  {m.videolar && uzun.length > 0 && <section class="sec"><div class="wrap"><VideoDuvar videos={uzun} channel={site.youtube} /></div></section>}

  <MobilAlan ad={api.pickAd(ads, 'mr', 2)} />

  {incelemeler.length > 0 && <Incelemeler items={incelemeler} no={no()} />}

  <Ad slot="lb" ad={api.pickAd(ads, 'lb', 1)} />
  <MobilAlan ad={api.pickAd(ads, 'mr', 3)} />

  {m.kiyasRobotu && katalog.length >= 2 && <Versus katalog={katalog} kiyaslar={kiyaslar} no={no()} />}

  {m.kunyeRafi && katalog.length > 0 && <TurRafi katalog={katalog} no={no()} />}
</Base>
