---
/** Kıyaslamalar (27 Ekim 2026): kıyas aracına giriş (tür + iki ürün), türlere göre hazır başlangıçlar, editör kıyas yazıları. Form ana sayfayla ortak (KiyasForm). */
import Base from '../../layouts/Base.astro'
import '../../styles/kiyas.css'
import CardStd from '../../components/CardStd.astro'
import KiyasForm from '../../components/KiyasForm.astro'
import * as api from '../../lib/api'
import { listMeta } from '../../lib/seo'
import { glyph } from '../../lib/ui'
import { kiyasGruplari } from '../../lib/turler'
const [items, katalog] = await Promise.all([api.getComparisons(), api.kunyeKatalog()])
const gruplar = kiyasGruplari(katalog)
---
<Base meta={listMeta('Kıyaslamalar', 'Ürünleri yan yana koy: teknik puan, UPscore, önde olduğu özellikler ve kaynaklı tam özellik tablosu.', '/karsilastirma', items.map((c) => ({ path: c.path, title: c.title })))}>
  <div class="wrap">
    <div class="art-head" style="max-width:none;padding-bottom:24px"><div class="chips"><span class="lbl l-kiy">Kıyasla</span></div><h1 class="h1">Kıyaslamalar</h1><p class="lead" style="margin:0;max-width:62ch">İki ila dört ürünü yan yana koy. Teknik puanı künyedeki değerler belirler, UPscore'u cihazı kullanan editör verir.</p></div>

    <KiyasForm katalog={katalog} />

    {gruplar.length > 0 && <section style="margin-top:48px"><div class="sh"><h2>Hazır başlangıçlar</h2><span class="meta">Her türün en dolu iki künyesi</span></div>
      <div class="kb-hazir">{gruplar.map((g) => <a class="kk" href={`/karsilastirma/kiyas?u=${g.l[0].s},${g.l[1].s}`}><Fragment set:html={glyph(g.t, 40)} /><span class="eyebrow">{g.ad}</span><b><span translate="no">{g.l[0].n}</span> mi, <span translate="no">{g.l[1].n}</span> mi?</b></a>)}</div></section>}

    {items.length > 0 && <section style="margin-top:48px"><div class="sh"><h2>Editör kıyasları</h2></div><div class="grid3">{items.map((c, i) => <CardStd item={c} eager={i < 3} />)}</div></section>}
  </div>
</Base>
<style>
  .kb-hazir{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px}
  .kb-hazir a{text-decoration:none;color:var(--text);gap:8px}.kb-hazir a:hover{border-color:var(--text)}.kb-hazir svg{color:var(--text-3)}
</style>
