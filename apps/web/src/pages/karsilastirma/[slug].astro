---
import YanSutun from '../../components/YanSutun.astro'
import Base from '../../layouts/Base.astro'
import Img from '../../components/Img.astro'
import Topluluk from '../../components/Topluluk.astro'
import KunyeMini from '../../components/KunyeMini.astro'
import Ad from '../../components/Ad.astro'
import InfiniteFeed from '../../components/InfiniteFeed.astro'
import * as api from '../../lib/api'
import { comparisonMeta } from '../../lib/seo'
import { date } from '../../lib/format'
import { chip } from '../../lib/ui'
import KiyasMasasi from '../../components/KiyasMasasi.astro'
import type { Comparison } from '../../lib/types'
export async function getStaticPaths() {
  return (await api.allComparisons()).map((c) => ({ params: { slug: c.path.split('/').pop() }, props: { c } }))
}
// Adres hep alfabetik (a-vs-b); ters sıra .htaccess'te 301 (scripts/postbuild.mjs).
const { c } = Astro.props as { c: Comparison }
const [ads, videos, reels, site] = await Promise.all([api.getAds(), api.getVideos(), api.getReels(), api.getSite()])
// Kıyas masası (27 Ekim 2026): editör yazısı (kısa cevap, can alıcı farklar, kime hangisi) + ortak masa (puanlar, farklar, tablo)
const katalog = await api.kunyeKatalog()
const ks = [c.a, c.b].map((p) => katalog.find((k) => k.s === p.slug)).filter((k) => !!k)
const nm = (w?: string) => (w === 'a' ? c.a.name : w === 'b' ? c.b.name : '')
---
<Base meta={comparisonMeta(c)}>
  <div class="wrap">
    <div class="art-head" style="max-width:none">
      <div class="chips"><span class="lbl l-kiy">Karşılaştırma</span></div>
      <div class="vs" style="margin-top:8px">
        <div class="side"><span class="c-img" style="width:100%"><Img img={c.a.image} alt={c.a.name} eager /></span><h2>{c.a.name}</h2><Fragment set:html={chip(c.a)} /></div>
        <span class="x" aria-hidden="true">VS</span>
        <div class="side r"><span class="c-img" style="width:100%"><Img img={c.b.image} alt={c.b.name} eager /></span><h2>{c.b.name}</h2><Fragment set:html={chip(c.b)} /></div>
      </div>
      <h1 class="h2" style="margin-top:16px">{c.title}</h1>
      <div class="kunye-row"><a class="yz-link" href={`/yazar/${c.author.slug}`} rel="author"><Fragment set:html={yazarFoto(c.author, 32)} />{c.author.name}</a><span>·</span><time datetime={c.publishedAt}>{date(c.publishedAt)}</time>{c.method && <><span>·</span><span>{c.method}</span></>}<a href="#topluluk" data-yorum-say hidden></a></div>
    </div>
    <div class="with-rail" style="margin-top:24px">
      <div>
        {c.shortAnswer && <div class="short" style="margin-top:0"><span class="label">Kısa cevap</span><p>{c.shortAnswer}</p></div>}
        {c.keyDiffs.length > 0 && <><div class="sh" style="margin-top:32px"><h2>Can alıcı {c.keyDiffs.length} fark</h2></div>
          <div class="kd">{c.keyDiffs.map((d) => <div><span class="big">{d.big}</span><b>{d.label}</b>{d.winner && <span class="w">Önde: <b>{nm(d.winner)}</b></span>}</div>)}</div></>}
        <Ad slot="in" ad={api.pickAd(ads, 'in')} />
        {ks.length === 2 && <div style="margin-top:32px"><KiyasMasasi ks={ks}>
          {c.whoFor && (c.whoFor.a || c.whoFor.b) && <section><div class="sh"><h2>Kime hangisi</h2></div><div class="kv" style="margin:0"><div><h3>{c.a.name} al, eğer…</h3><p>{c.whoFor.a}</p></div><div><h3>{c.b.name} al, eğer…</h3><p>{c.whoFor.b}</p></div></div></section>}
        </KiyasMasasi></div>}
        <Topluluk hedef={`comparisons:${c.id}`} />
      </div>
      <YanSutun haric={c.path} ads={ads}><div><h2 class="label" style="color:var(--text-3);margin:0 0 8px">Künyeler</h2><div class="kstack"><KunyeMini p={c.a} /><KunyeMini p={c.b} /></div></div></YanSutun>
    </div>
  </div>
  <div class="wrap" style="padding-top:48px"><InfiniteFeed title="Okumaya devam et" source="son" items={[]} videos={videos} reels={reels} ads={ads} channel={site.youtube} profile={site.instagram} renderFirst={false} /></div>
</Base>
