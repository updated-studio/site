---
export const partial = true
/** Künye etiketi üzerine gelince açılan kart (statik HTML parçası). */
import Img from '../../../components/Img.astro'
import { allProductSlugs, getProduct } from '../../../lib/api'
import { durum, glyph, s20 } from '../../../lib/ui'
export async function getStaticPaths() { return (await allProductSlugs()).map((slug) => ({ params: { slug } })) }
const p = await getProduct(Astro.params.slug!)
const known = (p?.specs || []).filter((s) => s.value).slice(0, 3)
const n = p ? p.news.length + p.reviews.length : 0
---
{p && <>
  {p.image && <div class="pc-img"><Img img={p.image} alt={p.name} eager sizes="300px" /></div>}
  <div class="pc-top"><Fragment set:html={glyph(p.type, 34)} /><span><span class="eyebrow" lang="en" translate="no">{p.brand}</span><b>{p.name}</b></span>{p.score && <span class="pc-sc">{s20(p.score)}</span>}</div>
  <div><Fragment set:html={durum(p.status)} /></div>
  {known.length ? <dl>{known.map((s) => <div><dt>{s.key}</dt><dd>{s.value}</dd></div>)}</dl> : <p class="pc-unk">Teknik veriler henüz doğrulanmadı.</p>}
  <a class="btn pri" href={`/urun/${p.slug}`}>Künyeyi aç · {n} içerik →</a>
</>}
