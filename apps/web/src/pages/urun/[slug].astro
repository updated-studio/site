---
/**
 * KÜNYE — ürün sayfası. Bu ürüne bağlı her haber, inceleme ve kıyas burada listelenir.
 * Teknik değerler: bilinmeyen değer "Bilinmiyor" kalır, uydurulmaz. Kaynak sütunu 5 Kasım 2026'da kalktı (kullanıcı: "sitede kaynak göstermeye
 * gerek yok; ürünün hangi aşamada olduğu zaten belli"); değerler üreticinin resmî kaynağından gelir, kaynak panelde kayıtlı kalır.
 * Söküm çizimi ve Topla düğmesi 5 Kasım 2026'da kalktı (kullanıcı: "kaldır gitsin"); sahnede üreticinin arka planı silinmiş ürün fotoğrafı.
 * Albüm (6 Kasım 2026, kullanıcı: "künyelerde birden çok görsel olabilir; ana görsel yine tek ürün"): sahnenin altında üreticinin diğer
 * Yorumlar (6 Kasım 2026, kullanıcı: "künyeye bağla"): yorum ürüne bağlıdır; aynı yorumlar kıyas aracında o ürün seçilince de görünür.
 * görselleri yatay şeritte; tıklayınca sayfada büyür (dialog), betik çalışmazsa bağlantı görseli açar.
 */
import Base from '../../layouts/Base.astro'
import Img from '../../components/Img.astro'
import Ad from '../../components/Ad.astro'
import Topluluk from '../../components/Topluluk.astro'
import * as api from '../../lib/api'
import { productMeta } from '../../lib/seo'
import { date } from '../../lib/format'
import { chip, durum, glyph, kes, LVN, s10, tamAd } from '../../lib/ui'
export async function getStaticPaths() {
  return (await api.allProductSlugs()).map((slug) => ({ params: { slug } }))
}
const p = (await api.getProduct(Astro.params.slug!))!
const [ads, shelf] = await Promise.all([api.getAds(), api.getProducts(8)])
const specs = p.specs || []
const feed = [
  ...p.reviews.map((r) => ({ tag: 'İNCELEME', cls: 'İNCELEME', title: r.title, d: date(r.publishedAt), href: r.path, s: s10(r.score), at: r.publishedAt })),
  ...(p.comparisons || []).map((c) => ({ tag: 'KIYAS', cls: 'KIYAS', title: c.title, d: date(c.publishedAt), href: c.path, s: '', at: c.publishedAt })),
  ...p.news.map((n) => ({ tag: n.label === 'sizinti' ? 'SÖYLENTİ' : 'HABER', cls: 'TANITIM', title: n.title, d: date(n.publishedAt), href: n.path, s: '', at: n.publishedAt })),
].sort((a, b) => +new Date(b.at) - +new Date(a.at))
// Bilinmeyen özellikler tabloyu "Bilinmiyor" satırlarıyla doldurmasın (31 Ekim 2026): bilinenler tabloda, kalanlar altta tek satır
const bilinen = specs.filter((s) => s.value), eksik = specs.filter((s) => !s.value)
const rel = shelf.filter((q) => q.slug !== p.slug).slice(0, 4)
const status = api.statusText(p.status)
// Kıyas aracı (27 Ekim 2026): rakip girilmişse onunla, yoksa araç aynı türün en dolu künyesini rakip yapar
const kiyas = `/karsilastirma/kiyas?u=${[p.slug, ...p.rivals.slice(0, 1).map((r) => r.slug)].join(',')}`
const album = p.album || []
const albumAd = p.fullName ?? p.name
---
<Base meta={{ ...productMeta(p), noindex: (p.specs || []).filter((s) => s.value).length < 5 && !p.news.length && !p.reviews.length }}>
  <header class="ku-hero"><div class="wrap ku-top">
    <div class="ku-copy">
      <nav class="crumbs" aria-label="Konum"><a href="/">Ana sayfa</a><span aria-hidden="true">/</span><a href="/urun">Künye</a><span aria-hidden="true">/</span><span>{p.name}</span></nav>
      <span class="eyebrow ku-eb">Künye · <span lang="en" translate="no">{p.brand}</span></span>
      <h1 class="ku-h1" translate="no">{tamAd(p.brand, p.fullName ?? p.name)}</h1>
      {p.blurb && <p class="ku-blurb">{p.blurb}</p>}
      <div class="ku-status">
        <Fragment set:html={durum(p.status)} />
        {!['satista', 'eol'].includes(p.status) && <span class="ku-conf">Kesinlik <Fragment set:html={kes(p.certainty)} /></span>}
        {p.score != null && (p.upscoreUrl || p.reviews[0]) && <a class="ku-score" href={p.upscoreUrl || p.reviews[0].path}><b>{s10(p.score)}</b><span>UPscore</span></a>}
      </div>
      <div class="ku-actions"><a class="btn pri" href={`/rss/urun/${p.slug}.xml`}>Takip et (RSS)</a><a class="btn" href={kiyas}>Kıyasla</a></div>
      {p.amazon && <div class="ku-amz">
        <a class="btn" href={p.amazon.url} target="_blank" rel="sponsored nofollow noopener">{p.amazon.metin ? <>Amazon'da <b>{p.amazon.metin}</b></> : "Amazon'da gör"}</a>
        <p>{p.amazon.metin && <>Fiyat {new Date(p.amazon.guncel).toLocaleString('tr-TR', { day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Istanbul' })} itibarıyla Amazon Türkiye'den alındı, değişebilir. </>}Bu bağlantıdan yapılan alışverişten Updated komisyon alabilir.</p>
      </div>}
      <div class="ku-stats">{[[feed.length, 'içerik'], [p.news.length, 'haber'], [p.reviews.length, 'inceleme']].filter(([n]) => n).map(([n, t]) => <span><b>{n}</b> {t}</span>)}{specs.length > 0 && <span><b>{bilinen.length}/{specs.length}</b> doğrulanmış özellik</span>}</div>
    </div>
    <div class={`ku-stage${p.image ? '' : ' bos'}`}>
      {p.image ? <Img class="ku-foto" img={p.image} alt={p.fullName ?? p.name} eager sizes="(max-width: 1000px) 100vw, 55vw" />
        : <><Fragment set:html={glyph(p.type, 96)} /><span class="eyebrow">Ürün görseli hazırlanıyor</span></>}
    </div>
  </div></header>

  {album.length > 0 && <section class="wrap ku-album" aria-label="Albüm">
    <div class="ku-alb-bas"><h2 class="eyebrow">Albüm</h2><span class="eyebrow">{album.length} görsel · <span lang="en" translate="no">{p.brand}</span></span></div>
    <div class="ku-serit" tabindex="0" role="region" aria-label={`${albumAd} albümü`}>
      {album.map((g, i) => <a class="ku-kare" href={g.url} data-album={i} data-not={g.credit || ''} style={`aspect-ratio:${g.w || 16}/${g.h || 9}`}><Img img={g} alt={g.alt || `${albumAd}, albüm görseli ${i + 1}`} sizes="(max-width: 767px) 80vw, 460px" /></a>)}
    </div>
    <dialog class="ku-lb" data-album-kutu aria-label="Albüm görseli">
      <img alt="" />
      <div class="ku-lb-alt"><span data-sayac></span><span data-not></span>
        <span class="ku-lb-dugme"><button type="button" class="btn" data-yon="-1">Önceki</button><button type="button" class="btn" data-yon="1">Sonraki</button><button type="button" class="btn" data-kapat>Kapat</button></span></div>
    </dialog>
  </section>}

  <section class="wrap ku-grid">
    <div>
      <div class="sec-head" style="margin-bottom:12px"><div><span class="eyebrow">Ürün veritabanından · her değer kaynağıyla</span><h2 class="sec-title ku-h2">Teknik künye</h2></div></div>
      {bilinen.length > 0 ? (
        <div class="tbl-box" tabindex="0" role="region" aria-label="Teknik özellikler"><table class="ku-tbl"><thead><tr><th scope="col">Özellik</th><th scope="col">Değer</th></tr></thead><tbody>
          {bilinen.map((s) => <tr><th scope="row">{s.key}</th><td>{s.value}</td></tr>)}
        </tbody></table></div>
      ) : <p class="pc-unk">Teknik veriler henüz doğrulanmadı. Değerler kaynağıyla girildikçe burada görünür.</p>}
      {/* Doğrulanmamış özellik sayısı okuyucuya gösterilmez (7 Kasım 2026, kullanıcı: "okuyana göstermesine gerek yok") */}
      <p class="ku-note">Değerler üretici beyanı, Updated ölçümü ve diğer kaynaklar olarak ayrı saklanır. Çakışan değerler QC onayına düşer; onaylanınca bu künyeye bağlı tüm haber, inceleme ve kıyaslar birlikte güncellenir.</p>
      <div class="sec-head" style="margin:48px 0 12px"><div><span class="eyebrow">Bu ürünle ilgili her şey</span><h2 class="sec-title ku-h2">Akış</h2></div></div>
      {feed.length ? <ol class="ku-feed">{feed.map((f) => <li><a href={f.href}><span class={`tag t-${f.cls}`}>{f.tag}</span><b>{f.title}</b><span class="d">{f.d}</span>{f.s && <span class="s">{f.s}</span>}</a></li>)}</ol> : <p class="pc-unk">Bu ürünle ilgili henüz içerik yok.</p>}
      {p.id && <Topluluk hedef={`products:${p.id}`} class="tp-urun">
        <div slot="bas" class="sec-head" style="margin-bottom:12px"><div><span class="eyebrow">Kullananlar ve almayı düşünenler</span><h2 class="sec-title ku-h2" id="tp-baslik">Yorumlar</h2></div></div>
      </Topluluk>}
    </div>
    <aside class="rail" aria-label="Yan sütun">
      <div class="ku-box"><h2>Kıyasla</h2>{p.rivals.length ? <Fragment set:html={p.rivals.map((r) => chip(r)).join('')} /> : <p class="pc-unk">Henüz kıyas yok.</p>}<a class="btn" href={kiyas} style="margin-top:10px">Başka ürünle kıyasla</a></div>
      {p.id && <div class="ku-box ku-kullanan" data-kullananlar={p.id}><h2>Kullananlar</h2><div class="pc-unk" data-ic>Yükleniyor…</div></div>}
      {!['satista', 'eol'].includes(p.status) && <div class="ku-box"><h2>Çıkış radarı</h2><div class="pc-st"><Fragment set:html={durum(p.status)} />{p.releaseWhen && <span>{p.releaseWhen}</span>}</div></div>}
      <Ad slot="mr" ad={api.pickAd(ads, 'mr')} bare />
    </aside>
  </section>

  {rel.length > 0 && <section class="sec ku-rel"><div class="wrap"><div class="sec-head"><div><span class="eyebrow">Künye rafı</span><h2 class="sec-title">Benzer ürünler</h2></div></div>
    <div class="shelfk">{rel.map((q) => <a class="kcard" href={`/urun/${q.slug}`}><Fragment set:html={glyph(q.type, 46)} /><b translate="no"><span class="mk">{q.brand}</span> {q.name}</b><Fragment set:html={durum(q.status)} />{q.score && <span class="kc-sc">{s10(q.score)}</span>}</a>)}</div>
  </div></section>}
</Base>
<script>
  // Albüm: görsele tıklayınca sayfada büyür; ok tuşları ve düğmelerle gezilir. Betik yoksa bağlantı görselin kendisini açar.
  const kutu = document.querySelector<HTMLDialogElement>('[data-album-kutu]')
  const kareler = [...document.querySelectorAll<HTMLAnchorElement>('[data-album]')]
  if (kutu && kareler.length && typeof kutu.showModal === 'function') {
    const img = kutu.querySelector('img')!, sayac = kutu.querySelector<HTMLElement>('[data-sayac]')!, not = kutu.querySelector<HTMLElement>('[data-not]')!
    let sira = 0
    const goster = (i: number) => {
      sira = (i + kareler.length) % kareler.length
      const k = kareler[sira]
      img.src = k.href; img.alt = k.querySelector('img')?.alt || ''
      sayac.textContent = `${sira + 1} / ${kareler.length}`; not.textContent = k.dataset.not || ''
    }
    kareler.forEach((k, i) => k.addEventListener('click', (e) => { if (e.metaKey || e.ctrlKey || e.shiftKey) return; e.preventDefault(); goster(i); kutu.showModal() }))
    kutu.querySelectorAll<HTMLElement>('[data-yon]').forEach((d) => d.addEventListener('click', () => goster(sira + Number(d.dataset.yon))))
    kutu.querySelector('[data-kapat]')!.addEventListener('click', () => kutu.close())
    kutu.addEventListener('click', (e) => { if (e.target === kutu) kutu.close() })
    kutu.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') goster(sira + 1); else if (e.key === 'ArrowLeft') goster(sira - 1) })
    if (kareler.length < 2) kutu.querySelectorAll<HTMLElement>('[data-yon]').forEach((d) => { d.hidden = true })
  }
</script>
