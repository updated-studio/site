---
/** Konular (28 Ekim 2026): bütün haber kategorileri tek bakışta; her biri kendi akışına gider. */
import type { Cat } from '../../lib/types'
interface Props { items: Cat[]; no?: string }
const { items, no = '' } = Astro.props
---
{items.length > 0 && <>
  <div class="sh"><h2>{no && <span class="no">{no}</span>}Konular</h2><span class="meta">Her konunun kendi akışı var</span></div>
  <ul class="kat-l">{items.map((c) => <li><a href={`/${c.slug}`}>{c.name}</a></li>)}</ul>
</>}
<style is:global>
  .kat-l{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:8px}
  .kat-l a{display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border:1px solid var(--line);background:var(--surface);border-radius:var(--r-dugme,0);text-decoration:none;font-weight:600;font-size:15px;color:var(--text);box-shadow:var(--cam-golge,none)}
  .kat-l a:hover{border-color:var(--text)}
</style>
