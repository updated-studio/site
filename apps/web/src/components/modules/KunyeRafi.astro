---
import Strip from '../Strip.astro'
import Img from '../Img.astro'
import type { ProductRef } from '../../lib/types'
import { conf, glyph, s20 } from '../../lib/ui'
import { statusText } from '../../lib/api'
interface Props { products: ProductRef[] }
const { products } = Astro.props
---
{products.length > 0 && (
  <Strip title="Künyeler" sub="Ürün veritabanı · her ürünün tüm haberleri" moreHref="/urun" moreLabel="Tümü">
    {products.map((q) => (
      <a class="kcard" style="width:260px" href={`/urun/${q.slug}`}>
        {q.image ? <span class="c-img" style="margin:-16px -16px 8px"><Img img={q.image} alt="" sizes="260px" /></span> : <Fragment set:html={glyph(q.type, 40)} />}
        <span class="eyebrow">{q.brand}</span><b>{q.name}</b>
        <span class="pc-st"><Fragment set:html={conf(q.certainty)} /><span>{statusText(q.status)}</span></span>
        {q.score && <span class="kc-sc">{s20(q.score)}</span>}
      </a>
    ))}
  </Strip>
)}
