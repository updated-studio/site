---
/**
 * "Bugün 90 saniyede" (1 Kasım 2026; adı kullanıcıyla 60 → 90 saniye, kullanıcı: "oynat ve kaydırma düğmelerine gerek yok, parmakla kaydırır; özet sunuyorsak seslendirme ya da
 * başka bir deneyim olmalı, normal slider'dan farkı olmalı"). Altı haber kart şeridinde, parmakla ya da tekerle kaydırılır; düğme yok.
 * "Dinle" (1 Kasım 2026, kullanıcı: "robot gibi; gerçek insan sesi, kısa özet ve yorum, cihazın ses panelinden kontrol"): sunucuda hazırlanan
 * sesli bülten (Gemini metin + doğal Türkçe ses; Stüdyo ozet-ses + panel lib/ozetSes.ts → media/ozet/son.json). Oynatıcı ortak (scripts/ozet.ts; sağ alt köşe düğmesiyle aynı ses);
 * Media Session ile kilit ekranı / denetim merkezi / bildirimden oynat-duraklat, ileri-geri (haber haber) yönetilir. Konuşulan haberin kartı
 * öne gelir, çubuk sesle ilerler. Bülten yoksa ya da 36 saatten eskiyse düğme görünmez. Kit: kendiliğinden dönen slayt yok; ses okur başlatınca.
 */
import Img from '../Img.astro'
import type { News } from '../../lib/types'
import { ico } from '../../lib/ui'
interface Props { items: News[]; no?: string }
const { items, no = '05' } = Astro.props
const kisa = (s: string) => { const t = (s || '').replace(/\s+/g, ' ').trim(); const c = t.match(/^.{40,200}?[.!?](\s|$)/); return c ? c[0].trim() : t.slice(0, 180) }
const list = items.slice(0, 6)
// Özet başlığı tekrar ediyorsa (bazı haberlerde spot başlıkla başlar) başlık kısmı atılır
const tekrarsiz = (t: string, s: string) => { const b = t.split(':')[0].trim(); return s.startsWith(b) ? s.slice(s.indexOf(t) === 0 ? t.length : b.length).replace(/^[\s:.,–-]+/, '') : s }
const metin = list.map((n) => ({ c: n.category.name, t: n.title, s: kisa(tekrarsiz(n.title, n.spot || '')) }))
---
{list.length > 0 && <section class="oz" data-ozet={JSON.stringify(metin)} aria-labelledby="oz-bas">
  <div class="sh oz-sh"><h2 id="oz-bas"><span class="no">{no}</span>Bugün 90 saniyede</h2>
    <button class="btn btn-p oz-dinle" type="button" data-dinle hidden><span class="oz-ikon" data-dinle-i set:html={ico('play', 16)} /><span data-dinle-y>Dinle</span></button>
  </div>
  <div class="oz-segs" aria-hidden="true">{list.map(() => <i><b></b></i>)}</div>
  <ol class="oz-iz" data-oz-iz>
    {list.map((n, i) => (
      <li class="oz-k" data-i={i}>
        <a href={n.path}>
          <span class="oz-g">{n.cover && <Img img={n.cover} alt="" sizes="(max-width: 760px) 85vw, 400px" />}<span class="oz-no">{i + 1}/{list.length}</span></span>
          <span class="oz-m"><span class="cat">{n.category.name}</span><h3>{n.title}</h3><span class="oz-s">{metin[i].s}</span></span>
        </a>
      </li>
    ))}
  </ol>
  <details class="oz-metin" data-oz-metin hidden><summary>Bültenin metni</summary><p data-oz-metin-p></p></details>
  </section>}
<script>
  import { ozetYukle, olay, calDuraklat, caliyor, zaman, basladi, git, sn, type Ozet } from '../../scripts/ozet'
  const box = document.querySelector<HTMLElement>('[data-ozet]')
  const IKON = { play: '<svg class="ico" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" stroke="none"/></svg>', pause: '<svg class="ico" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z" fill="currentColor" stroke="none"/></svg>' }
  if (box) ozetYukle().then((o) => { if (o) kur(o) })
  function kur(oz: Ozet) {
    const b = box!
    const btn = b.querySelector<HTMLButtonElement>('[data-dinle]')!, yazi = b.querySelector('[data-dinle-y]')!, ikon = b.querySelector('[data-dinle-i]')!
    const iz = b.querySelector<HTMLElement>('[data-oz-iz]')!, kartlar = [...b.querySelectorAll<HTMLElement>('.oz-k')], cubuk = [...b.querySelectorAll<HTMLElement>('.oz-segs b')]
    const metin = b.querySelector<HTMLElement>('[data-oz-metin]')!
    b.querySelector('[data-oz-metin-p]')!.textContent = oz.metin; metin.hidden = false
    const yolu = (x: HTMLElement) => x.querySelector('a')?.getAttribute('href')
    const kartOf = (k: number) => kartlar.find((x) => yolu(x) === oz.maddeler[k]?.yol) ?? kartlar[k]
    const bitis = (k: number) => oz.maddeler[k + 1]?.bas ?? oz.sure
    yazi.textContent = `Dinle · ${sn(oz.sure)}`; btn.hidden = false
    // Kaymasız geçiş (1 Kasım 2026, kullanıcı: "geçişte kayma var"): kart şeridi kaydırılırken gelen kaydırma olayları okur hareketi sayılmaz;
    // hedef, kartın şeritteki gerçek konumundan (scroll-padding dahil) hesaplanır
    let otomatik = 0, simdiki = -1
    const kaydir = (x: HTMLElement) => {
      const pad = parseFloat(getComputedStyle(iz).scrollPaddingLeft) || 0
      otomatik = Date.now() + 900
      iz.scrollTo({ left: x.offsetLeft - iz.offsetLeft - pad, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' })
    }
    const goster = (t: number) => {
      let k = -1; oz.maddeler.forEach((m, q) => { if (t >= m.bas) k = q })
      cubuk.forEach((c, q) => { const m = oz.maddeler[q]; c.style.width = !m ? '0%' : t >= bitis(q) ? '100%' : t <= m.bas ? '0%' : `${((t - m.bas) / (bitis(q) - m.bas)) * 100}%` })
      if (k === simdiki) return; simdiki = k
      kartlar.forEach((x) => x.removeAttribute('data-simdi'))
      const x = k >= 0 ? kartOf(k) : null
      if (x) { x.setAttribute('data-simdi', ''); kaydir(x) }
    }
    const durum = () => {
      const c = caliyor()
      ikon.innerHTML = c ? IKON.pause : IKON.play
      yazi.textContent = c ? 'Duraklat' : basladi() ? 'Devam et' : `Dinle · ${sn(oz.sure)}`
      b.toggleAttribute('data-caliyor', c)
      if (!c && !basladi()) { cubuk.forEach((x) => (x.style.width = zaman() > 0 ? '100%' : '0%')); kartlar.forEach((x) => x.removeAttribute('data-simdi')); simdiki = -1 }
    }
    btn.addEventListener('click', () => calDuraklat(oz))
    olay.addEventListener('durum', durum); olay.addEventListener('zaman', () => goster(zaman()))
    // Okur kartı parmakla değiştirirse bülten o haberden sürer (en yakın kart, gerçek konuma göre)
    let bekle = 0
    iz.addEventListener('scroll', () => {
      if (!caliyor() || Date.now() < otomatik) return
      clearTimeout(bekle); bekle = window.setTimeout(() => {
        const sol = iz.scrollLeft + iz.offsetLeft + (parseFloat(getComputedStyle(iz).scrollPaddingLeft) || 0)
        const x = kartlar.reduce((a, c) => (Math.abs(c.offsetLeft - sol) < Math.abs(a.offsetLeft - sol) ? c : a))
        const m = oz.maddeler.findIndex((y) => y.yol === yolu(x))
        if (m >= 0 && m !== simdiki) git(oz.maddeler[m].bas + 0.05)
      }, 450)
    }, { passive: true })
  }
</script>
<style is:global>
  .oz-sh{align-items:center}
  .oz-dinle{gap:8px}.oz-ikon{display:inline-flex}
  .oz-metin{margin-top:14px;font-size:15px;color:var(--text-2)}.oz-metin summary{cursor:pointer;font-weight:600;color:var(--text)}.oz-metin p{margin:8px 0 0;white-space:pre-line;line-height:1.6;max-width:72ch}
  .oz[data-caliyor] .oz-dinle{background:var(--text);color:var(--bg)}
  .oz-segs{display:flex;gap:4px;margin:0 0 12px}
  .oz-segs i{flex:1;height:3px;border-radius:2px;background:var(--line);overflow:hidden}
  .oz-segs b{display:block;height:100%;width:0;background:var(--orange)}
  .oz-iz{list-style:none;margin:0;padding:0;display:grid;grid-auto-flow:column;grid-auto-columns:calc((100% - 24px) / 3);gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;overscroll-behavior-x:contain}
  .oz-iz::-webkit-scrollbar{display:none}
  .oz-k{scroll-snap-align:start;min-width:0}
  .oz-k > a{display:flex;flex-direction:column;height:100%;border:1px solid var(--line);border-radius:var(--r-kart,0);background:var(--surface);box-shadow:var(--cam-golge,none);overflow:hidden;color:var(--text);text-decoration:none;transition:border-color var(--t2,200ms) var(--ease,ease)}
  .oz-k[data-simdi] > a{border-color:var(--orange);box-shadow:0 0 0 1px var(--orange),var(--cam-golge,none)}
  .oz-g{position:relative;display:block;aspect-ratio:16/9;background:var(--img)}
  .oz-g img{width:100%;height:100%;object-fit:cover;display:block}
  .oz-no{position:absolute;left:10px;top:10px;padding:2px 8px;border-radius:99px;background:rgb(0 0 0 / .6);color:#fff;font-family:var(--f-mono);font-size:12px;font-weight:600}
  .oz-m{display:flex;flex-direction:column;gap:6px;padding:14px 16px 18px}
  .oz-m h3{margin:0;font-size:21px;line-height:1.22}
  .oz-s{font-size:15px;line-height:1.45;color:var(--text-2)}
  .oz-k > a:hover h3{text-decoration:underline}
  @media (max-width:1100px){.oz-iz{grid-auto-columns:calc((100% - 12px) / 2)}}
  @media (max-width:760px){.oz-iz{grid-auto-columns:86%;margin-inline:calc(-1 * max(16px,env(safe-area-inset-left,0px)));padding-inline:max(16px,env(safe-area-inset-left,0px));scroll-padding-inline:max(16px,env(safe-area-inset-left,0px))}}
</style>
