---
/**
 * Ana sayfanın ilk bölümü (Fatih, 26 Ekim 2026): solda 13 manşet (A biçimi: fotoğraf bütün kutuyu kaplar, başlık üstünde,
 * altta hikâye çubukları; geniş ve alçak), yanında "Son videolar" (Instagram Reels; yoksa YouTube kısa videoları), sağda
 * 300×600 dikey afiş. Afiş yoksa basılmaz. Manşet 7 sn'de bir geçer; fare/odak üstündeyken, sekme arkadayken ve
 * "hareketi azalt" açıkken durur. Telefonda parmakla kaydırılır.
 */
import Img from '../Img.astro'
import Ad from '../Ad.astro'
import type { Ad as AdT, Comparison, News, Reel, Review, Video } from '../../lib/types'
import { date, time } from '../../lib/format'
import { ico } from '../../lib/ui'
import { showAdSlots } from '../../lib/env'
interface Props { slides: (News | Review | Comparison)[]; reels: Reel[]; shorts: Video[]; ad: AdT | null; instagram: string; youtube: string }
const { slides, reels, shorts, ad, instagram, youtube } = Astro.props
const afis = !!ad || showAdSlots()
const kat = (m: News | Review | Comparison) => m.kind === 'news' ? { ad: m.category.name, href: `/${m.category.slug}` } : m.kind === 'review' ? { ad: 'İnceleme', href: '/inceleme' } : { ad: 'Karşılaştırma', href: '/karsilastirma' }
const ig = reels.length > 0
const videolar = ig ? reels.slice(0, 10) : shorts.slice(0, 10)
---
<div class:list={['mn', { 'mn-afissiz': !afis }]}>
  <div class:list={['mn-ic', { 'mn-tek': videolar.length === 0 }]}>
    <section class="mn-sl" data-mn aria-roledescription="slider" aria-label={`Manşet: ${slides.length} haber`}>
      {slides.map((m, i) => { const k = kat(m); return (
        <article class="mn-s" hidden={i > 0} aria-roledescription="slayt" aria-label={`${i + 1} / ${slides.length}`}>
          <a class="mn-g" href={m.path} tabindex="-1" aria-hidden="true"><Img img={m.cover} alt="" eager={i === 0} sizes="(max-width: 1100px) 100vw, 920px" /></a>
          <div class="mn-b">
            <a class="mn-kat" href={k.href}>{k.ad}</a>
            <h2><a href={m.path}>{m.title}</a></h2>
            <span class="mn-meta">{m.author.name} · {date(m.publishedAt)} · {time(m.publishedAt)}</span>
          </div>
        </article>
      ) })}
      {slides.length > 1 && <>
        <div class="mn-cb">{slides.map((_, i) => <button type="button" data-mn-git={i} aria-label={`${i + 1}. manşet`} aria-current={i === 0 ? 'true' : undefined}><i></i></button>)}</div>
        <button class="mn-ok sol" type="button" data-mn-yon="-1" aria-label="Önceki manşet"><Fragment set:html={ico('left', 22)} /></button>
        <button class="mn-ok sag" type="button" data-mn-yon="1" aria-label="Sonraki manşet"><Fragment set:html={ico('right', 22)} /></button>
      </>}
    </section>

    {videolar.length > 0 && <aside class="mv" aria-label="Son videolar">
      <div class="mv-h">
        <div><h2>Son videolar</h2><span class="cat">{ig ? 'Instagram · @updated.tr' : 'YouTube · Nerdesin Fatih'}</span></div>
        <div class="mv-ok"><button class="ibtn" type="button" data-mv="-1" aria-label="Son videolar: geri"><Fragment set:html={ico('left', 16)} /></button><button class="ibtn" type="button" data-mv="1" aria-label="Son videolar: ileri"><Fragment set:html={ico('right', 16)} /></button></div>
      </div>
      <div class="mv-iz" data-mv-iz tabindex="0" aria-label="Son videolar şeridi">
        {ig ? (reels.slice(0, 10).map((r) => (
          <a class="mv-k" href={r.url} target="_blank" rel="noopener"><span class="c-img"><Img img={r.cover} alt="" sizes="170px" /><span class="mv-oy" set:html={ico('play', 18)} /></span><span class="mv-t">{r.caption}</span></a>
        ))) : (shorts.slice(0, 10).map((v) => (
          <a class="mv-k" href={`https://www.youtube.com/shorts/${v.youtubeId}`} target="_blank" rel="noopener" data-yt={v.youtubeId}><span class="c-img"><Img img={v.thumb} alt="" sizes="170px" /><span class="mv-oy" set:html={ico('play', 18)} /></span><span class="mv-t">{v.title}</span></a>
        )))}
      </div>
      <a class="mv-hep" href={ig ? instagram : `${youtube}/shorts`} target="_blank" rel="noopener">{ig ? 'Instagram’da takip et' : 'Tüm kısa videolar'} <Fragment set:html={ico('right', 14)} /></a>
    </aside>}
  </div>

  {afis && <div class="mn-af"><Ad slot="hp" ad={ad} bare /></div>}
</div>

<script>
  const AZ = matchMedia('(prefers-reduced-motion: reduce)').matches
  const SURE = 7000
  document.querySelectorAll<HTMLElement>('[data-mn]').forEach((s) => {
    const sl = Array.from(s.querySelectorAll<HTMLElement>('.mn-s'))
    if (sl.length < 2) return
    const cb = Array.from(s.querySelectorAll<HTMLButtonElement>('[data-mn-git]'))
    let i = 0, t0 = performance.now(), dur = false, kalan = 0
    const ciz = (o: number) => cb.forEach((b, k) => b.style.setProperty('--d', String(k < i ? 1 : k === i ? o : 0)))
    function git(n: number) {
      i = (n + sl.length) % sl.length
      sl.forEach((x, k) => { x.hidden = k !== i })
      cb.forEach((b, k) => k === i ? b.setAttribute('aria-current', 'true') : b.removeAttribute('aria-current'))
      const s2 = sl[(i + 1) % sl.length].querySelector('img'); if (s2) s2.loading = 'eager' // sıradakini önceden yükle
      t0 = performance.now(); ciz(AZ ? 1 : 0)
    }
    s.querySelectorAll<HTMLButtonElement>('[data-mn-yon]').forEach((b) => b.addEventListener('click', () => git(i + Number(b.dataset.mnYon))))
    cb.forEach((b) => b.addEventListener('click', () => git(Number(b.dataset.mnGit))))
    const durdur = () => { if (!dur) { dur = true; kalan = performance.now() - t0 } }
    const surdur = () => { if (dur) { dur = false; t0 = performance.now() - kalan } }
    s.addEventListener('mouseenter', durdur); s.addEventListener('mouseleave', surdur)
    s.addEventListener('focusin', durdur); s.addEventListener('focusout', surdur)
    let x0: number | null = null
    s.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; durdur() }, { passive: true })
    s.addEventListener('touchend', (e) => { if (x0 != null) { const d = e.changedTouches[0].clientX - x0; if (Math.abs(d) > 40) git(i + (d < 0 ? 1 : -1)) } x0 = null; surdur() })
    ciz(AZ ? 1 : 0)
    if (!AZ) { const dongu = (t: number) => { if (!dur && !document.hidden) { const o = (t - t0) / SURE; if (o >= 1) git(i + 1); else ciz(o) } requestAnimationFrame(dongu) }; requestAnimationFrame(dongu) }
  })
  document.querySelectorAll<HTMLElement>('.mv').forEach((m) => {
    const iz = m.querySelector<HTMLElement>('[data-mv-iz]')!
    m.querySelectorAll<HTMLButtonElement>('[data-mv]').forEach((b) => b.addEventListener('click', () => {
      const k = iz.querySelector<HTMLElement>('.mv-k'); iz.scrollBy({ left: Number(b.dataset.mv) * ((k?.offsetWidth || 160) + 10) * 2, behavior: AZ ? 'auto' : 'smooth' })
    }))
  })
</script>
