---
import Logo from './Logo.astro'
import { ico } from '../lib/ui'
import { getCategories, kunyeKatalog, type SiteCfg } from '../lib/api'
import { TUR } from '../lib/turler'
import BreakingStrip from './BreakingStrip.astro'
import type { News } from '../lib/types'
interface Props { site: SiteCfg; current?: string; hot?: News[] }
const { site, current = '', hot = [] } = Astro.props
const nav = site.nav.slice(0, 7) // kit 10b: en fazla 7
const kategoriler = await getCategories()
// Alt şerit bölüme göre değişir (1 Kasım 2026, kullanıcı: "haberlerin altındayken haber kategorileri, onun dışında araçlar gibi kategoriler;
// kategoriler haberlerle sınırlı olmamalı"): Haberler → haber kategorileri; İncelemeler, Kıyaslamalar/Künyeler → ürün türleri ve araçlar;
// Rehber → öğrenme ve uygulama yolları. Ana sayfada şerit yok; Kulüp çatısının kendi sekme şeridi var (KulupSerit / kulup.js).
const ilk = (current.split('/')[1] || '').replace(/\.html$/, '') // derlemede liste sayfalarının yolu .html ile gelir
type Oge = { href: string; ad: string; aktif?: boolean }
let alt: { ad: string; ogeler: Oge[] } | null = null
if (ilk === 'haberler' || kategoriler.some((c) => c.slug === ilk)) {
  alt = { ad: 'Haber kategorileri', ogeler: [{ href: '/haberler', ad: 'Tümü', aktif: ilk === 'haberler' }, ...kategoriler.map((c) => ({ href: `/${c.slug}`, ad: c.name, aktif: ilk === c.slug }))] }
} else if (['inceleme', 'karsilastirma', 'urun'].includes(ilk)) {
  const var_ = new Set((await kunyeKatalog()).map((k) => k.t)), turler = Object.keys(TUR).filter((t) => var_.has(t) && t !== 'other') // panel sırası: kamera, lens, dron…
  const sabit: Oge[] = ilk === 'inceleme'
    ? [{ href: '/inceleme', ad: 'Tüm incelemeler', aktif: true }, { href: '/inceleme#yazilar', ad: 'İnceleme yazıları' }, { href: '/inceleme#videolar', ad: 'Video incelemeler' }, { href: '/test-yontemimiz', ad: 'Test yöntemimiz' }]
    : [{ href: '/karsilastirma/kiyas', ad: 'Kıyas aracı', aktif: current.startsWith('/karsilastirma/kiyas') }, { href: '/karsilastirma', ad: 'Kıyaslamalar', aktif: ilk === 'karsilastirma' && !current.startsWith('/karsilastirma/kiyas') }, { href: '/urun', ad: 'Tüm künyeler', aktif: ilk === 'urun' }]
  alt = { ad: 'Ürünler', ogeler: [...sabit, ...turler.map((t) => ({ href: `/urun#${t}`, ad: TUR[t] })), { href: '/araclar', ad: 'Araçlar' }] }
} else if (ilk === 'rehber') {
  alt = { ad: 'Öğren ve uygula', ogeler: [{ href: '/rehber', ad: 'Tüm rehberler', aktif: true }, { href: '/araclar', ad: 'Araçlar' }, { href: '/kulup#dersler', ad: 'Kulüp dersleri' }, { href: '/kulup#pratik', ad: 'Simülatörler' }, { href: '/karsilastirma/kiyas', ad: 'Kıyas aracı' }, { href: '/urun', ad: 'Künyeler' }, { href: '/test-yontemimiz', ad: 'Test yöntemimiz' }] }
}
const katGoster = !!alt
/** Etkin bölüm: Ana Sayfa yalnız kökte; Kıyaslamalar künye sayfalarını da kapsar */
const BOLUM: Record<string, string[]> = { '/karsilastirma': ['/karsilastirma', '/urun'] }
// Kulüp çatısı (1 Kasım 2026): dersler, araçlar, haftalık görev, yarışmalar
const kulupte = [site.kulupUrl, '/araclar', '/gorev', '/yarismalar'].some((b) => current.startsWith(b))
const on = (h: string) => ((h === '/' ? current === '/' : (BOLUM[h] || [h]).some((b) => current.startsWith(b))) ? 'page' : undefined)
// Dil menüsü (31 Ekim 2026, kullanıcı: "önizleme dili, Google sayfa çevirisi bile yapıyor"): sayfa Google Çeviri'nin ücretsiz sayfa çevirisinde açılır;
// sunucuya yük yok, arama motorlarına ayrı dil olarak bildirilmez. Gerçek çok dilli site sonraya bırakıldı.
const DILLER: [string, string][] = [['en', 'English'], ['de', 'Deutsch'], ['ru', 'Русский'], ['es', 'Español'], ['ar', 'العربية'], ['zh-CN', '中文']]
---
<header class:list={["hdr", { katsiz: !katGoster }]} id="hdr">
  <div class="wrap">
    {/* Logonun altında çizgi ve el yazısıyla "Nerdesin Fatih" (4 Kasım 2026, kullanıcı isteği; yazı tipi Caveat 600, OFL, yalnız bu harfler) */}
    <a class="logo logo-imzali" href="/" aria-label="UPDATED ana sayfa · Nerdesin Fatih"><Logo /><span class="logo-imza" aria-hidden="true">Nerdesin Fatih</span></a>
    <nav class="nav" aria-label="Bölümler">
      {nav.map((n) => <a href={n.href} aria-current={on(n.href)}>{n.label}</a>)}
      {/* Kulüp ana menünün sağında, dik çizgiyle ayrı (2 Kasım 2026, kullanıcı: "logonun yanında bir şey olmasın") */}
      <i class="nav-ayrac" aria-hidden="true"></i>
      <a class="kulup" href={site.kulupUrl} aria-current={kulupte ? 'page' : undefined}>Kulüp</a>
    </nav>
    <div class="hdr-r">
      <button class="srch" type="button" data-open-search aria-label="Ara"><Fragment set:html={ico('search')} /><span>Ara</span></button>
      <button class="ibtn" type="button" data-theme-btn aria-label="Görünüm"><Fragment set:html={ico('auto')} /></button>
      <details class="dil" data-dil><summary class="ibtn" aria-label="Dil / Language" title="Language"><Fragment set:html={ico('dil')} /></summary>
        <div class="dil-m" role="menu">{DILLER.map(([k, ad]) => <a role="menuitem" href={`https://updated-com-tr.translate.goog/?_x_tr_sl=tr&_x_tr_tl=${k}`} data-dil-kod={k} lang={k} rel="nofollow">{ad}</a>)}<span>Google Translate</span></div>
      </details>
      <a class="btn btn-p" href="#bulten">Bülten</a>
      <a class="ibtn uye-b" href="/hesap" data-uye-btn aria-label="Uper ol / giriş yap" title="Uper ol / giriş yap"><Fragment set:html={ico('user')} /></a>
      <button class="ibtn menu-b" type="button" data-menu aria-expanded="false" aria-controls="sheet" aria-label="Menü"><Fragment set:html={ico('menu')} /></button>
    </div>
  </div>
  {/* Telefonda ve tablette ana bölümler en üstte, kategoriler altında (1 Kasım 2026, kullanıcı): masaüstü üst menüsünün aynısı, menü düğmesine girmeden */}
  <nav class="bolum-serit" aria-label="Bölümler (telefon)"><div class="wrap">
    {nav.map((n) => <a href={n.href} aria-current={on(n.href)}>{n.label}</a>)}
    <i class="nav-ayrac" aria-hidden="true"></i>
    <a class="kulup" href={site.kulupUrl} aria-current={kulupte ? 'page' : undefined}>Kulüp</a>
  </div></nav>
  {/* Kategori şeridi (30 Ekim 2026, kullanıcı: "üst barın altında kategoriler her zaman, mobilde de bilgisayarda da"): üst menüyle birlikte yapışık */}
  <BreakingStrip items={hot} />
  {alt && <nav class="kat-serit" aria-label={alt.ad}><div class="wrap">
    {alt.ogeler.map((o) => <a href={o.href} aria-current={o.aktif ? 'page' : undefined}><span>{o.ad}</span></a>)}
  </div></nav>}
</header>
<script is:inline>(()=>{document.querySelectorAll('[data-dil-kod]').forEach(a=>{a.href='https://updated-com-tr.translate.goog'+location.pathname+'?_x_tr_sl=tr&_x_tr_tl='+a.dataset.dilKod+'&_x_tr_hl='+a.dataset.dilKod})})()</script>
<script is:inline>(()=>{document.querySelectorAll('.kat-serit [aria-current=page],.bolum-serit [aria-current=page],.kserit [aria-current=page]').forEach(a=>{const w=a.parentElement;w.scrollLeft=a.offsetLeft-(w.clientWidth-a.offsetWidth)/2})})()</script>
<nav class="sheet" id="sheet" aria-label="Menü" hidden>
  {/* Menü (1 Kasım 2026, kullanıcı: "üst menüde olan menüde tekrar olmasın, üç çizgiyi farklı değerlendirelim"): bölümler ve kategoriler
      üst şeritlerde; menü açılınca şeritler gizlenir, burada geri kalan her şey ayrıntılı durur. */}
  <a class="sh-hesap" href="/hesap" data-sheet-hesap><Fragment set:html={ico('user')} /><span><b>Hesabım</b><span>Uper ol ya da giriş yap: yorum, kayıt, puan</span></span></a>
  <div class="sh-grup"><span class="label">Kulüp</span>
    <a href={site.kulupUrl}>Kulüp ana sayfa</a><a href={`${site.kulupUrl}#dersler`}>Dersler</a><a href={`${site.kulupUrl}#pratik`}>Simülatörler</a><a href="/araclar">Araçlar</a><a href="/gorev">Haftalık görev</a><a href="/yarismalar">Yarışmalar</a>
  </div>
  <div class="sh-grup"><span class="label">Keşfet</span>
    <a href="/urun">Künyeler</a><a href="/karsilastirma/kiyas">Kıyas aracı</a><a href="/ara">Arama</a><a href="/haberler">Tüm haberler</a>
  </div>
  <div class="sh-grup"><span class="label">Takip et</span>
    <a href={site.youtube} target="_blank" rel="noopener">YouTube</a><a href={site.instagram} target="_blank" rel="noopener">Instagram</a><a href="#bulten">Bülten</a><a href="/rss.xml">RSS</a>
  </div>
  <div class="sh-grup sh-dil"><span class="label">Language</span>{DILLER.map(([k, ad]) => <a href={`https://updated-com-tr.translate.goog/?_x_tr_sl=tr&_x_tr_tl=${k}`} data-dil-kod={k} lang={k} rel="nofollow">{ad}</a>)}</div>
  <div class="sheet-tema"><span>Görünüm</span><button class="ibtn" type="button" data-theme-btn aria-label="Görünüm"><Fragment set:html={ico('auto')} /></button></div>
  <div class="sh-grup sh-kurumsal"><span class="label">UPDATED</span>
    <a href="/hakkimizda">Hakkımızda</a><a href="/yayin-ilkeleri">Yayın ilkeleri</a><a href="/iletisim">İletişim</a><a href="/reklam">Reklam ver</a>
  </div>
</nav>
