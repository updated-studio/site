---
import type { ProductRef } from '../lib/types'
import { durum, glyph, s20 } from '../lib/ui'
interface Props { p: ProductRef }
const { p } = Astro.props
---
<a class="kcard mini" href={`/urun/${p.slug}`}>
  <Fragment set:html={glyph(p.type, 40)} />
  <span class="eyebrow">Künye · {p.brand}</span><b>{p.name}</b>
  <Fragment set:html={durum(p.status)} />
  {p.score && <span class="kc-sc">{s20(p.score)}</span>}
  <span class="kc-go">Künyeyi aç →</span>
</a>
