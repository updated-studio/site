---
/** Yan sütun "son dakika" modülü: en yeni 7 haber, saat (bir günden eskiyse tarih), kategori. */
import type { News } from '../lib/types'
import { short, time } from '../lib/format'
import { ico } from '../lib/ui'
interface Props { items: News[] }
const { items } = Astro.props
const now = Date.now()
---
<aside class="sdk" aria-label="Son dakika">
  <div class="sdk-h"><span class="lbl l-son">Son dakika</span><span class="mono" data-clock></span></div>
  <ol>
    {items.slice(0, 7).map((n) => (
      <li class={n.label === 'son-dakika' && now - +new Date(n.publishedAt) < 24 * 3600e3 ? 'hot' : ''}><span class="t">{now - +new Date(n.publishedAt) < 20 * 3600e3 ? time(n.publishedAt) : short(n.publishedAt)}</span><a href={n.path}>{n.title}</a><span class="c">{n.category.name}{n.label === 'sizinti' ? ' · sızıntı' : ''}</span></li>
    ))}
  </ol>
  <a class="all" href="/haberler">Tüm haber akışı <Fragment set:html={ico('right', 16)} /></a>
</aside>
