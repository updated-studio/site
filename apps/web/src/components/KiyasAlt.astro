---
/**
 * Kıyas sayfasının altı (6 Kasım 2026; kullanıcı: "lens kategorisindeki haberler tek şerit, ardından videolar, ardından reels varsa,
 * ardından tekrar haberler, bitmeyen sayfa"; her ürün grubu kendi kategorisiyle): ürün türünün kategorisinden haber şeridi →
 * YouTube şeridi → Reels şeridi (liste boşsa hiç çıkmaz; paylaşım gelince sonraki derlemede kendiliğinden eklenir) → sonsuz haber akışı.
 * Videolar ve Reels kategoriye göre etiketli değil, kanalın en yenileri gösterilir. Kıyas aracında tür değişince aynı parça
 * /parca/kiyas-alt/<tür> adresinden yeniden alınır (scripts/kiyas.ts).
 */
import Strip from './Strip.astro'
import CardStd from './CardStd.astro'
import YtStrip from './YtStrip.astro'
import ReelStrip from './ReelStrip.astro'
import InfiniteFeed from './InfiniteFeed.astro'
import * as api from '../lib/api'
interface Props { tur: string }
const { tur } = Astro.props
/** Ürün türü → haber kategorisi */
const KATEGORI: Record<string, string> = {
  camera: 'kamera', lens: 'lens', drone: 'dron', cam360: 'v-aksiyon', phone: 'telefon', gimbal: 'studyo-ve-ekipman', light: 'studyo-ve-ekipman', mic: 'studyo-ve-ekipman',
  headphones: 'kulaklik', audio: 'kulaklik', laptop: 'pc-konsol', pad: 'pc-konsol', tablet: 'tablet-telefon-ve-mobil-cihazlar', watch: 'akilli-saat', accessory: 'elektronik',
}
const [kategoriler, videos, reels, ads, site] = await Promise.all([api.getCategories(), api.getVideos(12), api.getReels(14), api.getAds(), api.getSite()])
const kat = kategoriler.find((c) => c.slug === KATEGORI[tur])
const haberler = kat ? (await api.getCategoryNews(kat.slug, 1)).slice(0, 8) : []
---
{haberler.length > 0 && kat && (
  <div class="km-serit"><Strip title={`${kat.name} haberleri`} moreHref={`/${kat.slug}`} moreLabel="Tümü">{haberler.map((n) => <CardStd item={n} />)}</Strip></div>
)}
<YtStrip videos={videos} channel={site.youtube} />
<ReelStrip reels={reels} profile={site.instagram} />
{haberler.length > 0 && kat
  ? <InfiniteFeed title={`${kat.name} haberleri, devamı`} source={`kategori-${kat.slug}`} basePath={`/${kat.slug}`} items={[]} videos={videos} reels={reels} ads={ads} channel={site.youtube} profile={site.instagram} startPage={1} renderFirst={false} />
  : <InfiniteFeed title="Okumaya devam et" source="son" items={[]} videos={videos} reels={reels} ads={ads} channel={site.youtube} profile={site.instagram} renderFirst={false} />}
