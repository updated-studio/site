---
/**
 * Yazının topluluk bölümü (Uper'ler, 24 Ekim 2026): tepkiler, kaydet, paylaş, yorumlar.
 * Hedef yazı ya da ürün olabilir (products:<id>, 6 Kasım 2026): künyede tepki düğmeleri çıkmaz, okuma puanı verilmez.
 * Sayfa statik; bölümü scripts/uye.ts panelin /api/uye/sayfa ucundan doldurur. JS kapalıysa yalnız bağlantı görünür.
 */
interface Props { hedef: string; class?: string }
const { hedef, class: sinif } = Astro.props
---
<section class:list={['tp', sinif]} id="topluluk" data-hedef={hedef} aria-labelledby="tp-baslik">
  <slot name="bas"><div class="sh tp-sh"><h2 id="tp-baslik">Yorumlar</h2></div></slot>
  <div class="tp-ic" data-tp-ic><p class="meta">Yorumlar yükleniyor…</p></div>
  <noscript><p>Yorumları görmek ve yorum yapmak için JavaScript gerekir. <a href="/hesap">Uper ol</a>.</p></noscript>
</section>
