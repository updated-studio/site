---
/** Son dakika şeridi: yalnız aktif haber varken. Kayan şerit (25 Ekim 2026, kullanıcı isteği): haberler sağdan sola akar,
 *  üzerine gelince / odaklanınca durur; "hareketi azalt" açıksa akmaz, elle kaydırılır. Akış scripts/site.ts breaking(). */
import type { News } from '../lib/types'
import { time } from '../lib/format'
interface Props { items: News[] }
const { items } = Astro.props
const data = items.map((n) => ({ t: n.title, h: n.path, at: time(n.publishedAt) }))
---
{items.length > 0 && (
  <div class="sd" id="sd" role="region" aria-label="Son dakika" data-items={JSON.stringify(data)}>
    <div class="wrap">
      <span class="lbl l-son">Son dakika</span>
      <div class="sd-kay" data-sd-kay>
        <div class="sd-ray" data-sd-ray>
          {data.map((n) => <a href={n.h}><span class="t">{n.at}</span>{n.t}</a>)}
        </div>
      </div>
    </div>
  </div>
)}
