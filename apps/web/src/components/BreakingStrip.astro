---
/** Son dakika bandı (1 Kasım 2026, kullanıcı: "editör çok kritik son dakika girerse menü ile kategori şeridi arasında hızlı akan bant; fare
 *  üstüne gelince durmaz, akmaya devam eder; tıklanabilir"). Üst barın içinde, yapışık. Yalnız son 2 saatte "Son dakika" etiketli haber varken
 *  görünür; sonradan girilen son dakikayı canli.ts açar, süresi dolanı kapatır. "Hareketi azalt" açıksa akmaz, elle kaydırılır. Akış: site.ts breaking(). */
import type { News } from '../lib/types'
import { time } from '../lib/format'
interface Props { items: News[] }
const { items } = Astro.props
const data = items.map((n) => ({ t: n.title, h: n.path, at: time(n.publishedAt) }))
---
{(
  <div class="sd" id="sd" role="region" aria-label="Son dakika" data-items={JSON.stringify(data)} hidden={items.length === 0}>
    <div class="wrap">
      <span class="lbl l-son">Son dakika</span>
      <div class="sd-kay" data-sd-kay>
        <div class="sd-ray" data-sd-ray>
          {data.map((n) => <a href={n.h}><span class="t">{n.at}</span>{n.t}</a>)}
        </div>
      </div>
    </div>
  </div>
)}
