# Stüdyo ekranı (deploy/altyapi/studyo). Derlenmiş dosyalar /var/www/studio/aktif'te; yayinla.sh günceller.
(studyo_dosyalar) {
	root * /var/www/studio/aktif
	encode zstd gzip
	# Adı içerik özetli dosyalar hiç değişmez; giriş sayfası ve sürüm/yenilik dosyaları her açılışta taze
	@kalici path /assets/*
	header @kalici Cache-Control "public, max-age=31536000, immutable"
	@taze path / /index.html /surum.json /yenilikler.json /manifest.json
	header @taze Cache-Control "no-cache"
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}
	try_files {path} /index.html
	file_server
}

studio.updated.com.tr {
	# Ekip uygulamalarının indirme dosyaları (UPDATED Monitör APK vb.): tahmin edilemez klasör adıyla, dizin listesi kapalı
	handle_path /indir/* {
		root * /var/www/indir
		header Cache-Control "no-cache"
		# APK ve diğer dosyalar indirilir; uygulamaların önizleme sayfası (<klasör>/onizleme/) tarayıcıda açılır, aramaya kapalı
		@onizleme path_regexp ^/[^/]+/onizleme/
		header @onizleme X-Robots-Tag "noindex, nofollow"
		@indirme not path_regexp ^/[^/]+/onizleme/
		header @indirme Content-Disposition attachment
		file_server
	}
	# try_files indirme isteklerini index.html'e çevirmesin diye Stüdyo dosyaları ayrı handle içinde
	handle {
		import studyo_dosyalar
	}
}

# Yerel deneme ucu (yalnız sunucunun içinden; dışarıya kapalı): yayinla.sh ve kontroller kullanır
http://127.0.0.1:8090 {
	bind 127.0.0.1
	import studyo_dosyalar
}
